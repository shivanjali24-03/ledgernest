# Copy to .env and adjust. Never commit .env.

# PostgreSQL: local (see docs/DEVELOPMENT.md) or a free Neon database
DATABASE_URL="postgresql://postgres@localhost:5433/ledgernest_dev?host=/tmp"

# HTTP
PORT=3000
# Signs access tokens. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET="replace-with-a-long-random-string-of-48-plus-chars"

# Refresh-token cookie. Use COOKIE_SECURE=true in production (HTTPS).
# COOKIE_SAMESITE=none when the web app and API are on different sites.
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
LOGIN_RATE_LIMIT=10

# The web app's address, used in invitation links
WEB_APP_URL=http://localhost:5173

# Comma-separated list of web app origins allowed to call the API
CORS_ORIGINS="http://localhost:5173"

# First Super Admin, created by `npm run db:seed` (change the password!)
SEED_SUPERADMIN_EMAIL="superadmin@ledgernest.local"
SEED_SUPERADMIN_PASSWORD="ChangeMe!2026-strong"
SEED_SUPERADMIN_NAME="Platform Admin"
