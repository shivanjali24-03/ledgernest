// LedgerNest database schema.
// Conventions: UUID primary keys, created/updated timestamps, snake_case table names,
// and every business table carries organizationId for tenant isolation.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserStatus {
  ACTIVE
  SUSPENDED
}

enum OrganizationStatus {
  ACTIVE
  SUSPENDED
}

/// A person who can sign in. Platform-level Super Admins have isSuperAdmin = true.
model User {
  id                  String     @id @default(uuid()) @db.Uuid
  email               String     @unique /// stored lower-case
  name                String
  passwordHash        String     @map("password_hash")
  isSuperAdmin        Boolean    @default(false) @map("is_super_admin")
  status              UserStatus @default(ACTIVE)
  locale              String     @default("en")
  failedLoginAttempts Int        @default(0) @map("failed_login_attempts")
  lockedUntil         DateTime?  @map("locked_until")
  lastLoginAt         DateTime?  @map("last_login_at")
  createdAt           DateTime   @default(now()) @map("created_at")
  updatedAt           DateTime   @updatedAt @map("updated_at")

  memberships     Membership[]
  invitesSent     Invitation[]   @relation("InvitedBy")
  auditEntries    AuditLog[]
  refreshTokens   RefreshToken[]
  periodsClosed   Period[]       @relation("PeriodClosedBy")
  journalsCreated JournalEntry[] @relation("JournalCreatedBy")
  journalsPosted  JournalEntry[] @relation("JournalPostedBy")

  @@map("users")
}

/// A business (tenant). All accounting data belongs to exactly one organisation.
model Organization {
  id                   String             @id @default(uuid()) @db.Uuid
  name                 String
  slug                 String             @unique
  status               OrganizationStatus @default(ACTIVE)
  baseCurrency         String             @default("INR") @map("base_currency") @db.Char(3)
  locale               String             @default("en-IN")
  country              String?            @db.Char(2)
  fiscalYearStartMonth Int                @default(4) @map("fiscal_year_start_month") /// 1 = January … 4 = April (India)
  /// IANA zone; decides which calendar day a moment belongs to (period boundaries, report dates)
  timeZone             String             @default("Asia/Kolkata") @map("time_zone")
  legalName            String?            @map("legal_name")
  taxId                String?            @map("tax_id") /// GSTIN, VAT number…
  email                String?
  phone                String?
  addressLine1         String?            @map("address_line1")
  addressLine2         String?            @map("address_line2")
  city                 String?
  region               String? /// state, province or emirate
  postalCode           String?            @map("postal_code")
  createdAt            DateTime           @default(now()) @map("created_at")
  updatedAt            DateTime           @updatedAt @map("updated_at")

  memberships   Membership[]
  roles         Role[]
  invitations   Invitation[]
  auditEntries  AuditLog[]
  logo          OrganizationLogo?
  accounts      Account[]
  fiscalYears   FiscalYear[]
  periods       Period[]
  journals      JournalEntry[]
  journalLines  JournalLine[]
  journalFiles  JournalAttachment[]
  taxRates      TaxRate[]
  taxGroups     TaxGroup[]
  taxGroupRates TaxGroupRate[]
  currencies    OrganizationCurrency[]
  contacts      Contact[]
  items         Item[]
  invoices      Invoice[]
  invoiceLines  InvoiceLine[]
  exchangeRates ExchangeRate[]

  @@map("organizations")
}

/// An organisation's logo, kept apart so organisation queries never load image bytes by accident.
model OrganizationLogo {
  organizationId String   @id @map("organization_id") @db.Uuid
  contentType    String   @map("content_type") /// image/png | image/jpeg | image/webp, checked against the bytes
  data           Bytes
  updatedAt      DateTime @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@map("organization_logos")
}

/// An account in an organisation's chart of accounts. Sub-accounts share their parent's type.
model Account {
  id             String    @id @default(uuid()) @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  code           String /// unique per organisation, e.g. 1100 or 1100.01
  name           String /// unique per organisation, ignoring case (enforced by an index in the migration)
  type           String /// asset | liability | equity | income | expense
  subtype        String
  description    String?
  parentId       String?   @map("parent_id") @db.Uuid
  /// Set for accounts LedgerNest relies on (retained_earnings, opening_balance_equity); they can't be removed
  systemKey      String?   @map("system_key")
  archivedAt     DateTime? @map("archived_at")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")
  /// A foreign-currency account (assets and liabilities only); its lines are in this currency
  currency       String?   @db.Char(3)

  organization  Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  orgCurrency   OrganizationCurrency? @relation(fields: [organizationId, currency], references: [organizationId, code], onDelete: NoAction)
  currencyLines JournalLine[]         @relation("LineCurrency")
  incomeItems   Item[]                @relation("ItemIncome")
  expenseItems  Item[]                @relation("ItemExpense")
  /// Composite key: a parent always belongs to the same organisation, enforced by the database
  parent        Account?              @relation("AccountTree", fields: [organizationId, parentId], references: [organizationId, id], onDelete: NoAction)
  children      Account[]             @relation("AccountTree")
  taxOutputs    TaxRate[]             @relation("TaxOutputAccount")
  taxInputs     TaxRate[]             @relation("TaxInputAccount")
  lines         JournalLine[]

  invoiceReceivables Invoice[]     @relation("InvoiceReceivable")
  invoiceIncome      InvoiceLine[] @relation("InvoiceLineAccount")

  @@unique([organizationId, id])
  @@unique([organizationId, code])
  @@unique([organizationId, systemKey])
  @@unique([organizationId, id, currency])
  @@index([organizationId, parentId])
  @@map("accounts")
}

/// A financial year, split into monthly periods. Years follow on from each other without gaps.
model FiscalYear {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  name           String /// e.g. FY 2026–27
  startDate      DateTime @map("start_date") @db.Date
  endDate        DateTime @map("end_date") @db.Date
  createdAt      DateTime @default(now()) @map("created_at")
  /// The entry that moved the year's profit to retained earnings when its last month closed (none if there was nothing to move)
  closingEntryId String?  @map("closing_entry_id") @db.Uuid

  organization Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  periods      Period[]
  journals     JournalEntry[] @relation("FiscalYearEntries")
  closingEntry JournalEntry?  @relation("YearClosingEntry", fields: [organizationId, closingEntryId], references: [organizationId, id], onDelete: NoAction)

  invoices Invoice[]

  @@unique([organizationId, id])
  @@unique([organizationId, startDate])
  @@unique([organizationId, closingEntryId])
  @@map("fiscal_years")
}

/// A month of a financial year. A closed period accepts no new, changed or reversed entries.
model Period {
  id             String    @id @default(uuid()) @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  fiscalYearId   String    @map("fiscal_year_id") @db.Uuid
  number         Int /// 1–12 within the year
  startDate      DateTime  @map("start_date") @db.Date
  endDate        DateTime  @map("end_date") @db.Date
  status         String    @default("open") /// open | closed
  closedAt       DateTime? @map("closed_at")
  closedById     String?   @map("closed_by_id") @db.Uuid
  closeReason    String?   @map("close_reason")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  /// Composite key: a period always belongs to a year of the same organisation
  fiscalYear   FiscalYear   @relation(fields: [organizationId, fiscalYearId], references: [organizationId, id], onDelete: Cascade)
  closedBy     User?        @relation("PeriodClosedBy", fields: [closedById], references: [id], onDelete: SetNull)

  @@unique([fiscalYearId, number])
  @@index([organizationId, startDate])
  @@map("periods")
}

/// A double-entry journal entry. Drafts can change freely; posted entries never change (a reversal corrects them).
model JournalEntry {
  id             String    @id @default(uuid()) @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  /// Gap-free per financial year, assigned when posted
  number         Int?
  fiscalYearId   String?   @map("fiscal_year_id") @db.Uuid
  date           DateTime  @db.Date
  memo           String?
  reference      String?
  status         String    @default("draft") /// draft | posted
  /// For a reversal: the entry it reverses
  reversalOfId   String?   @map("reversal_of_id") @db.Uuid
  createdById    String?   @map("created_by_id") @db.Uuid
  postedById     String?   @map("posted_by_id") @db.Uuid
  postedAt       DateTime? @map("posted_at")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  organization Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  fiscalYear   FiscalYear?         @relation("FiscalYearEntries", fields: [organizationId, fiscalYearId], references: [organizationId, id], onDelete: NoAction)
  closesYear   FiscalYear?         @relation("YearClosingEntry")
  reversalOf   JournalEntry?       @relation("Reversal", fields: [organizationId, reversalOfId], references: [organizationId, id], onDelete: NoAction)
  reversedBy   JournalEntry?       @relation("Reversal")
  createdBy    User?               @relation("JournalCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  postedBy     User?               @relation("JournalPostedBy", fields: [postedById], references: [id], onDelete: SetNull)
  lines        JournalLine[]
  attachments  JournalAttachment[]

  invoice       Invoice? @relation("InvoiceEntry")
  voidedInvoice Invoice? @relation("InvoiceVoidEntry")

  @@unique([organizationId, id])
  @@unique([organizationId, fiscalYearId, number])
  /// An entry is reversed at most once
  @@unique([organizationId, reversalOfId])
  @@index([organizationId, date])
  @@index([organizationId, status])
  @@map("journal_entries")
}

/// One debit or credit. Amounts are integers in the smallest currency unit.
model JournalLine {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  entryId        String   @map("entry_id") @db.Uuid
  lineNo         Int      @map("line_no")
  accountId      String   @map("account_id") @db.Uuid
  description    String?
  debit          BigInt   @default(0)
  credit         BigInt   @default(0)
  /// The tax group charged on this line (its amount is then the net value)
  taxGroupId     String?  @map("tax_group_id") @db.Uuid
  /// Whether the amount entered included the tax (kept so the draft can be edited as entered)
  taxInclusive   Boolean  @default(false) @map("tax_inclusive")
  /// Set on a tax line the system generated: the rate it charges, and the line it was charged on
  taxRateId      String?  @map("tax_rate_id") @db.Uuid
  taxSourceLine  Int?     @map("tax_source_line")
  /// A line on a foreign-currency account: the amount in that currency and the rate it was converted at
  currency       String?  @db.Char(3)
  foreignDebit   BigInt   @default(0) @map("foreign_debit")
  foreignCredit  BigInt   @default(0) @map("foreign_credit")
  rate           Decimal? @db.Decimal(20, 10)
  /// Set on an exchange-difference line generated on posting: the line whose settlement it records
  fxSourceLine   Int?     @map("fx_source_line")

  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  entry           JournalEntry @relation(fields: [organizationId, entryId], references: [organizationId, id], onDelete: Cascade)
  taxGroup        TaxGroup?    @relation(fields: [organizationId, taxGroupId], references: [organizationId, id], onDelete: NoAction)
  taxRate         TaxRate?     @relation(fields: [organizationId, taxRateId], references: [organizationId, id], onDelete: NoAction)
  /// A foreign line's currency must be its account's (the database checks; base lines have no currency)
  currencyAccount Account?     @relation("LineCurrency", fields: [organizationId, accountId, currency], references: [organizationId, id, currency], onDelete: NoAction)
  /// Composite key: a line can only use an account of its own organisation
  account         Account      @relation(fields: [organizationId, accountId], references: [organizationId, id], onDelete: NoAction)

  @@unique([entryId, lineNo])
  @@index([organizationId, accountId])
  @@map("journal_lines")
}

/// A supporting document (receipt, invoice scan) attached to an entry.
model JournalAttachment {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  entryId        String   @map("entry_id") @db.Uuid
  fileName       String   @map("file_name")
  contentType    String   @map("content_type")
  size           Int
  data           Bytes
  uploadedById   String?  @map("uploaded_by_id") @db.Uuid
  createdAt      DateTime @default(now()) @map("created_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  entry        JournalEntry @relation(fields: [organizationId, entryId], references: [organizationId, id], onDelete: Cascade)

  @@index([entryId])
  @@map("journal_attachments")
}

/// A custom role defined by an organisation. Built-in roles live in @ledgernest/shared, not here.
model Role {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  name           String
  description    String?
  permissions    String[] /// keys from @ledgernest/shared, validated on write
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  memberships  Membership[]
  invitations  Invitation[]

  @@unique([organizationId, name])
  @@map("roles")
}

/// A user's place in an organisation: either a built-in role key or a custom role.
model Membership {
  id             String   @id @default(uuid()) @db.Uuid
  userId         String   @map("user_id") @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  builtInRole    String?  @map("built_in_role") /// owner | admin | accountant | bookkeeper | auditor | viewer
  customRoleId   String?  @map("custom_role_id") @db.Uuid
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  customRole   Role?        @relation(fields: [customRoleId], references: [id], onDelete: Restrict)

  @@unique([userId, organizationId])
  @@index([organizationId])
  @@map("memberships")
}

/// An emailed invitation to join an organisation. Only a hash of the token is stored.
model Invitation {
  id             String    @id @default(uuid()) @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  email          String
  builtInRole    String?   @map("built_in_role")
  customRoleId   String?   @map("custom_role_id") @db.Uuid
  tokenHash      String    @unique @map("token_hash")
  expiresAt      DateTime  @map("expires_at")
  acceptedAt     DateTime? @map("accepted_at")
  revokedAt      DateTime? @map("revoked_at")
  invitedById    String    @map("invited_by_id") @db.Uuid
  createdAt      DateTime  @default(now()) @map("created_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  invitedBy    User         @relation("InvitedBy", fields: [invitedById], references: [id])
  /// Deleting a custom role withdraws pending invitations for it
  customRole   Role?        @relation(fields: [customRoleId], references: [id], onDelete: Cascade)

  @@index([organizationId, email])
  @@map("invitations")
}

/// Append-only record of who did what. Never updated or deleted by the application.
model AuditLog {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String?  @map("organization_id") @db.Uuid /// null for platform-level actions
  actorId        String?  @map("actor_id") @db.Uuid /// null for system actions
  /// Who did it, copied from the user when the entry is written (kept even if the user is later deleted)
  actorEmail     String?  @map("actor_email")
  action         String /// e.g. organization.create, user.login.failed
  entityType     String?  @map("entity_type")
  entityId       String?  @map("entity_id")
  before         Json?
  after          Json?
  ip             String?
  userAgent      String?  @map("user_agent")
  createdAt      DateTime @default(now()) @map("created_at")

  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  actor        User?         @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([organizationId, createdAt(sort: Desc)])
  @@index([actorId, createdAt(sort: Desc)])
  @@index([createdAt(sort: Desc)])
  @@map("audit_logs")
}

/// One refresh token in a rotation chain. Only the SHA-256 hash is stored.
/// All tokens from one sign-in share a familyId; reusing an old token revokes the whole family.
model RefreshToken {
  id           String    @id @default(uuid()) @db.Uuid
  userId       String    @map("user_id") @db.Uuid
  familyId     String    @map("family_id") @db.Uuid
  tokenHash    String    @unique @map("token_hash")
  expiresAt    DateTime  @map("expires_at")
  revokedAt    DateTime? @map("revoked_at")
  replacedById String?   @map("replaced_by_id") @db.Uuid
  ip           String?
  userAgent    String?   @map("user_agent")
  createdAt    DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([familyId])
  @@index([userId])
  @@map("refresh_tokens")
}

/// A GST slab India's GST Council has set (0%, 5%, 18%, 40%…). Platform-wide and managed by the Super Admin;
/// organisations build their tax groups from it. A rate never changes: a slab is retired with an end date.
model GstSlab {
  id            String    @id @default(uuid()) @db.Uuid
  ratePpm       Int       @map("rate_ppm") /// parts per million: 180000 = 18%
  label         String
  description   String?
  effectiveFrom DateTime  @map("effective_from") @db.Date
  effectiveTo   DateTime? @map("effective_to") @db.Date
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  groups TaxGroup[]

  @@index([effectiveFrom])
  @@map("gst_slabs")
}

/// One tax component (CGST 9%, VAT 20%) and the accounts it posts to.
model TaxRate {
  id              String    @id @default(uuid()) @db.Uuid
  organizationId  String    @map("organization_id") @db.Uuid
  name            String
  kind            String /// cgst | sgst | utgst | igst | cess | vat | sales_tax | other
  ratePpm         Int       @map("rate_ppm")
  outputAccountId String    @map("output_account_id") @db.Uuid /// tax on sales, a liability
  inputAccountId  String?   @map("input_account_id") @db.Uuid /// tax on purchases, an asset (input credit)
  archivedAt      DateTime? @map("archived_at")
  createdAt       DateTime  @default(now()) @map("created_at")

  organization  Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  outputAccount Account        @relation("TaxOutputAccount", fields: [organizationId, outputAccountId], references: [organizationId, id], onDelete: NoAction)
  inputAccount  Account?       @relation("TaxInputAccount", fields: [organizationId, inputAccountId], references: [organizationId, id], onDelete: NoAction)
  groups        TaxGroupRate[]
  lines         JournalLine[]

  @@unique([organizationId, id])
  @@map("tax_rates")
}

/// What a line picks: one or more rates charged together (GST 18% = CGST 9% + SGST 9%).
model TaxGroup {
  id             String    @id @default(uuid()) @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  name           String
  gstSlabId      String?   @map("gst_slab_id") @db.Uuid /// set when made from a GST slab
  supply         String? /// intra | inter, for GST groups
  archivedAt     DateTime? @map("archived_at")
  createdAt      DateTime  @default(now()) @map("created_at")

  organization Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  gstSlab      GstSlab?       @relation(fields: [gstSlabId], references: [id], onDelete: Restrict)
  rates        TaxGroupRate[]
  lines        JournalLine[]
  items        Item[]

  invoiceLines InvoiceLine[]

  @@unique([organizationId, id])
  @@unique([organizationId, gstSlabId, supply])
  @@map("tax_groups")
}

model TaxGroupRate {
  organizationId String @map("organization_id") @db.Uuid
  groupId        String @map("group_id") @db.Uuid
  rateId         String @map("rate_id") @db.Uuid
  position       Int

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  group        TaxGroup     @relation(fields: [organizationId, groupId], references: [organizationId, id], onDelete: Cascade)
  rate         TaxRate      @relation(fields: [organizationId, rateId], references: [organizationId, id], onDelete: NoAction)

  @@id([groupId, rateId])
  @@index([organizationId, rateId])
  @@map("tax_group_rates")
}

/// A foreign currency an organisation trades in. The base currency is never in this list.
model OrganizationCurrency {
  organizationId String   @map("organization_id") @db.Uuid
  code           String   @db.Char(3)
  createdAt      DateTime @default(now()) @map("created_at")

  organization Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  rates        ExchangeRate[]
  accounts     Account[]
  contacts     Contact[]

  @@id([organizationId, code])
  @@map("organization_currencies")
}

/// "1 unit of the currency = rate units of the base currency" on a day. A day without a rate uses the latest before it.
model ExchangeRate {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  currency       String   @db.Char(3)
  date           DateTime @db.Date
  rate           Decimal  @db.Decimal(20, 10)
  /// manual | ecb (fetched from the European Central Bank's reference rates)
  source         String
  createdById    String?  @map("created_by_id") @db.Uuid
  updatedAt      DateTime @updatedAt @map("updated_at")

  organization Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  orgCurrency  OrganizationCurrency @relation(fields: [organizationId, currency], references: [organizationId, code], onDelete: Cascade)

  @@unique([organizationId, currency, date])
  @@map("exchange_rates")
}

/// A customer, a vendor or both.
model Contact {
  id               String    @id @default(uuid()) @db.Uuid
  organizationId   String    @map("organization_id") @db.Uuid
  name             String
  isCustomer       Boolean   @map("is_customer")
  isVendor         Boolean   @map("is_vendor")
  legalName        String?   @map("legal_name")
  /// GSTIN, VAT number, EIN…
  taxId            String?   @map("tax_id")
  email            String?
  phone            String?
  /// { line1, line2, city, region, postalCode, country }
  billingAddress   Json      @map("billing_address")
  /// null = same as billing
  shippingAddress  Json?     @map("shipping_address")
  /// GST state code for the place of supply (from the GSTIN, else the address); null outside India
  stateCode        String?   @map("state_code") @db.Char(2)
  /// Invoices and bills in this currency by default; null = the base currency
  currency         String?   @db.Char(3)
  paymentTermsDays Int       @default(30) @map("payment_terms_days")
  notes            String?
  archivedAt       DateTime? @map("archived_at")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  organization Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  orgCurrency  OrganizationCurrency? @relation(fields: [organizationId, currency], references: [organizationId, code], onDelete: NoAction)

  invoices Invoice[]

  @@unique([organizationId, id])
  @@index([organizationId, archivedAt])
  @@map("contacts")
}

/// A product or service to put on invoices and bills.
model Item {
  id               String    @id @default(uuid()) @db.Uuid
  organizationId   String    @map("organization_id") @db.Uuid
  name             String
  kind             String /// goods | service
  sku              String?
  description      String?
  unit             String?
  /// In the base currency's smallest unit
  salePrice        BigInt?   @map("sale_price")
  purchasePrice    BigInt?   @map("purchase_price")
  taxGroupId       String?   @map("tax_group_id") @db.Uuid
  /// HSN (goods) or SAC (services), for Indian GST invoices
  hsnSac           String?   @map("hsn_sac")
  incomeAccountId  String?   @map("income_account_id") @db.Uuid
  expenseAccountId String?   @map("expense_account_id") @db.Uuid
  archivedAt       DateTime? @map("archived_at")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  taxGroup       TaxGroup?    @relation(fields: [organizationId, taxGroupId], references: [organizationId, id], onDelete: NoAction)
  incomeAccount  Account?     @relation("ItemIncome", fields: [organizationId, incomeAccountId], references: [organizationId, id], onDelete: NoAction)
  expenseAccount Account?     @relation("ItemExpense", fields: [organizationId, expenseAccountId], references: [organizationId, id], onDelete: NoAction)

  invoiceLines InvoiceLine[]

  @@unique([organizationId, id])
  @@unique([organizationId, sku])
  @@index([organizationId, archivedAt])
  @@map("items")
}

/// A sales invoice. Drafts change freely; issuing gives it a number and posts its journal entry.
model Invoice {
  id                  String    @id @default(uuid()) @db.Uuid
  organizationId      String    @map("organization_id") @db.Uuid
  contactId           String    @map("contact_id") @db.Uuid
  /// Gap-free per financial year, given on issue
  number              Int?
  fiscalYearId        String?   @map("fiscal_year_id") @db.Uuid
  status              String    @default("draft") /// draft | issued | void
  issueDate           DateTime  @map("issue_date") @db.Date
  dueDate             DateTime  @map("due_date") @db.Date
  /// null = the base currency
  currency            String?   @db.Char(3)
  /// For a foreign-currency invoice: the rate it was posted at
  rate                Decimal?  @db.Decimal(20, 10)
  /// GST state code of the place of supply
  placeOfSupply       String?   @map("place_of_supply") @db.Char(2)
  reference           String?
  notes               String?
  receivableAccountId String?   @map("receivable_account_id") @db.Uuid
  /// In the invoice currency's smallest unit
  subtotal            BigInt    @default(0)
  taxTotal            BigInt    @default(0) @map("tax_total")
  total               BigInt    @default(0)
  amountPaid          BigInt    @default(0) @map("amount_paid")
  journalEntryId      String?   @map("journal_entry_id") @db.Uuid
  voidEntryId         String?   @map("void_entry_id") @db.Uuid
  createdById         String?   @map("created_by_id") @db.Uuid
  issuedAt            DateTime? @map("issued_at")
  voidedAt            DateTime? @map("voided_at")
  createdAt           DateTime  @default(now()) @map("created_at")
  updatedAt           DateTime  @updatedAt @map("updated_at")

  organization      Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  contact           Contact       @relation(fields: [organizationId, contactId], references: [organizationId, id], onDelete: NoAction)
  fiscalYear        FiscalYear?   @relation(fields: [organizationId, fiscalYearId], references: [organizationId, id], onDelete: NoAction)
  receivableAccount Account?      @relation("InvoiceReceivable", fields: [organizationId, receivableAccountId], references: [organizationId, id], onDelete: NoAction)
  journalEntry      JournalEntry? @relation("InvoiceEntry", fields: [organizationId, journalEntryId], references: [organizationId, id], onDelete: NoAction)
  voidEntry         JournalEntry? @relation("InvoiceVoidEntry", fields: [organizationId, voidEntryId], references: [organizationId, id], onDelete: NoAction)
  lines             InvoiceLine[]

  @@unique([organizationId, id])
  @@unique([organizationId, fiscalYearId, number])
  @@unique([organizationId, journalEntryId])
  @@unique([organizationId, voidEntryId])
  @@index([organizationId, contactId])
  @@index([organizationId, status, dueDate])
  @@map("invoices")
}

model InvoiceLine {
  id             String  @id @default(uuid()) @db.Uuid
  organizationId String  @map("organization_id") @db.Uuid
  invoiceId      String  @map("invoice_id") @db.Uuid
  lineNo         Int     @map("line_no")
  itemId         String? @map("item_id") @db.Uuid
  description    String
  quantity       Decimal @db.Decimal(13, 4)
  unitPrice      BigInt  @map("unit_price")
  discountPpm    Int     @default(0) @map("discount_ppm")
  taxGroupId     String? @map("tax_group_id") @db.Uuid
  accountId      String? @map("account_id") @db.Uuid
  /// Worked out from the above: net of discount, and its tax
  amount         BigInt
  taxAmount      BigInt  @default(0) @map("tax_amount")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  invoice      Invoice      @relation(fields: [organizationId, invoiceId], references: [organizationId, id], onDelete: Cascade)
  item         Item?        @relation(fields: [organizationId, itemId], references: [organizationId, id], onDelete: NoAction)
  taxGroup     TaxGroup?    @relation(fields: [organizationId, taxGroupId], references: [organizationId, id], onDelete: NoAction)
  account      Account?     @relation("InvoiceLineAccount", fields: [organizationId, accountId], references: [organizationId, id], onDelete: NoAction)

  @@unique([invoiceId, lineNo])
  @@map("invoice_lines")
}
