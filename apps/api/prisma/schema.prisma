// LedgerNest database schema.
// Conventions: UUID primary keys, created/updated timestamps, snake_case table names,
// and every business table carries organizationId for tenant isolation.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserStatus {
  ACTIVE
  SUSPENDED
}

enum OrganizationStatus {
  ACTIVE
  SUSPENDED
}

/// A person who can sign in. Platform-level Super Admins have isSuperAdmin = true.
model User {
  id                  String     @id @default(uuid()) @db.Uuid
  email               String     @unique /// stored lower-case
  name                String
  passwordHash        String     @map("password_hash")
  isSuperAdmin        Boolean    @default(false) @map("is_super_admin")
  status              UserStatus @default(ACTIVE)
  locale              String     @default("en")
  failedLoginAttempts Int        @default(0) @map("failed_login_attempts")
  lockedUntil         DateTime?  @map("locked_until")
  lastLoginAt         DateTime?  @map("last_login_at")
  /// Two-factor sign-in: the authenticator secret (AES-256-GCM encrypted), set when enabled (null while set up)
  totpSecret          String?    @map("totp_secret")
  totpEnabledAt       DateTime?  @map("totp_enabled_at")
  /// The last 30-second step a code was accepted for, so a code can't be used twice
  totpLastStep        Int?       @map("totp_last_step")
  /// SHA-256 hashes of unused recovery codes
  recoveryCodes       String[]   @default([]) @map("recovery_codes")
  createdAt           DateTime   @default(now()) @map("created_at")
  updatedAt           DateTime   @updatedAt @map("updated_at")

  memberships        Membership[]
  invitesSent        Invitation[]      @relation("InvitedBy")
  auditEntries       AuditLog[]
  refreshTokens      RefreshToken[]
  passwordResets     PasswordReset[]
  periodsClosed      Period[]          @relation("PeriodClosedBy")
  journalsCreated    JournalEntry[]    @relation("JournalCreatedBy")
  journalsPosted     JournalEntry[]    @relation("JournalPostedBy")
  approvalsRequested ApprovalRequest[] @relation("ApprovalRequester")
  approvalsDecided   ApprovalRequest[] @relation("ApprovalDecider")
  apiKeys            ApiKey[]
  webhooksChanged    WebhookEndpoint[]
  webhooksTriggered  WebhookDelivery[]

  @@map("users")
}

/// A business (tenant). All accounting data belongs to exactly one organisation.
model Organization {
  id                   String             @id @default(uuid()) @db.Uuid
  name                 String
  slug                 String             @unique
  status               OrganizationStatus @default(ACTIVE)
  baseCurrency         String             @default("INR") @map("base_currency") @db.Char(3)
  locale               String             @default("en-IN")
  country              String?            @db.Char(2)
  fiscalYearStartMonth Int                @default(4) @map("fiscal_year_start_month") /// 1 = January … 4 = April (India)
  /// IANA zone; decides which calendar day a moment belongs to (period boundaries, report dates)
  timeZone             String             @default("Asia/Kolkata") @map("time_zone")
  legalName            String?            @map("legal_name")
  taxId                String?            @map("tax_id") /// GSTIN, VAT number…
  email                String?
  phone                String?
  addressLine1         String?            @map("address_line1")
  addressLine2         String?            @map("address_line2")
  city                 String?
  region               String? /// state, province or emirate
  postalCode           String?            @map("postal_code")
  /// Printed at the foot of invoices and quotes: payment terms, bank details
  invoiceTerms         String?            @map("invoice_terms")
  /// UPI ID (name@bank) printed as a pay-by-UPI QR code on invoices
  upiId                String?            @map("upi_id")
  /// Email Owners and Admins a summary every Monday; the day it last went
  weeklySummary        Boolean            @default(false) @map("weekly_summary")
  /// Every member must sign in with two-factor before using this organisation
  requireTwoFactor     Boolean            @default(false) @map("require_two_factor")
  /// The business's own MSME category and Udyam number: micro and small can charge late buyers interest (MSMED Act s.16)
  msmeCategory         String?            @map("msme_category")
  udyamNumber          String?            @map("udyam_number")
  /// The RBI bank rate the interest is three times, in basis points
  msmeBankRateBp       Int?               @map("msme_bank_rate_bp")
  /// regular | composition: a composition dealer charges no GST and issues bills of supply
  gstScheme            String             @default("regular") @map("gst_scheme")
  /// The composition rate in basis points: 100 (traders, manufacturers), 500 (restaurants) or 600 (services)
  compositionRateBp    Int                @default(100) @map("composition_rate_bp")
  /// Interest on invoices paid late: yearly rate in basis points (null = none), simple or monthly, days of grace
  interestRateBp       Int?               @map("interest_rate_bp")
  interestMethod       String             @default("simple") @map("interest_method")
  interestGraceDays    Int                @default(0) @map("interest_grace_days")
  /// On the 1st of each month, draft interest invoices for what's accrued; the month it last did
  interestAutoRaise    Boolean            @default(false) @map("interest_auto_raise")
  interestRaisedFor    String?            @map("interest_raised_for")
  /// Round rupee invoice totals to the nearest rupee
  roundInvoiceTotals   Boolean            @default(false) @map("round_invoice_totals")
  /// Letter of undertaking for zero-rated supplies without IGST: its ARN and the dates it covers
  lutNumber            String?            @map("lut_number")
  /// The legal form (proprietorship, partnership, llp, private_limited…), and the business's PAN, TAN, CIN or LLPIN, and IEC
  businessType         String?            @map("business_type")
  pan                  String?
  tan                  String?
  cin                  String?
  iec                  String?
  /// Who signs invoices, printed under the signature
  signatoryName        String?            @map("signatory_name")
  signatoryDesignation String?            @map("signatory_designation")
  /// The account customers pay into, printed on invoices { accountName, accountNumber, ifsc, bankName, branch, accountType }
  bankDetails          Json?              @map("bank_details")
  lutFrom              DateTime?          @map("lut_from") @db.Date
  lutTo                DateTime?          @map("lut_to") @db.Date
  weeklySummarySentOn  DateTime?          @map("weekly_summary_sent_on") @db.Date
  createdAt            DateTime           @default(now()) @map("created_at")
  updatedAt            DateTime           @updatedAt @map("updated_at")

  memberships          Membership[]
  roles                Role[]
  invitations          Invitation[]
  auditEntries         AuditLog[]
  logo                 OrganizationLogo?
  images               OrganizationImage[]
  accounts             Account[]
  fiscalYears          FiscalYear[]
  periods              Period[]
  journals             JournalEntry[]
  journalLines         JournalLine[]
  journalFiles         JournalAttachment[]
  taxRates             TaxRate[]
  taxGroups            TaxGroup[]
  taxGroupRates        TaxGroupRate[]
  currencies           OrganizationCurrency[]
  contacts             Contact[]
  items                Item[]
  invoices             Invoice[]
  numberSeries         NumberSeries[]
  stockBatches         StockBatch[]
  stockSerials         StockSerial[]
  interestWaivers      InterestWaiver[]
  invoiceLines         InvoiceLine[]
  payments             Payment[]
  allocations          PaymentAllocation[]
  bills                Bill[]
  creditNotes          CreditNote[]
  creditNoteLines      CreditNoteLine[]
  creditApplications   CreditApplication[]
  vendorCredits        VendorCredit[]
  vendorCreditLines    VendorCreditLine[]
  vendorCreditApps     VendorCreditApplication[]
  recurringInvoices    RecurringInvoice[]
  bankTransactions     BankTransaction[]
  statementImports     BankStatementImport[]
  statementLines       BankStatementLine[]
  statementLayouts     BankStatementLayout[]
  bankMatches          BankMatch[]
  reconciliations      BankReconciliation[]
  fixedAssets          FixedAsset[]
  depreciationRuns     DepreciationRun[]
  depreciationLines    DepreciationLine[]
  budgets              Budget[]
  budgetLines          BudgetLine[]
  costCentres          CostCentre[]
  stockMovements       StockMovement[]
  approvalRules        ApprovalRule[]
  approvalRequests     ApprovalRequest[]
  documentAttachments  DocumentAttachment[]
  apiKeys              ApiKey[]
  billLines            BillLine[]
  exchangeRates        ExchangeRate[]
  webhookEndpoints     WebhookEndpoint[]
  webhookDeliveries    WebhookDelivery[]
  scheduledReports     ScheduledReport[]
  reportDeliveries     ReportDelivery[]
  reminderPolicy       ReminderPolicy?
  quotes               Quote[]
  quoteLines           QuoteLine[]
  balanceConfirmations BalanceConfirmation[]
  recurringBills       RecurringBill[]

  @@map("organizations")
}

/// The signatory's signature and the seal, printed on invoices; apart from the organisation like the logo
model OrganizationImage {
  organizationId String   @map("organization_id") @db.Uuid
  /// signature | seal
  kind           String
  contentType    String   @map("content_type") /// image/png | image/jpeg, checked against the bytes
  data           Bytes
  updatedAt      DateTime @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@id([organizationId, kind])
  @@map("organization_images")
}

/// An organisation's logo, kept apart so organisation queries never load image bytes by accident.
model OrganizationLogo {
  organizationId String   @id @map("organization_id") @db.Uuid
  contentType    String   @map("content_type") /// image/png | image/jpeg | image/webp, checked against the bytes
  data           Bytes
  updatedAt      DateTime @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@map("organization_logos")
}

/// An account in an organisation's chart of accounts. Sub-accounts share their parent's type.
model Account {
  id             String    @id @default(uuid()) @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  code           String /// unique per organisation, e.g. 1100 or 1100.01
  name           String /// unique per organisation, ignoring case (enforced by an index in the migration)
  type           String /// asset | liability | equity | income | expense
  subtype        String
  description    String?
  parentId       String?   @map("parent_id") @db.Uuid
  /// Set for accounts LedgerNest relies on (retained_earnings, opening_balance_equity); they can't be removed
  systemKey      String?   @map("system_key")
  archivedAt     DateTime? @map("archived_at")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")
  /// A foreign-currency account (assets and liabilities only); its lines are in this currency
  currency       String?   @db.Char(3)

  organization   Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  orgCurrency    OrganizationCurrency? @relation(fields: [organizationId, currency], references: [organizationId, code], onDelete: NoAction)
  currencyLines  JournalLine[]         @relation("LineCurrency")
  incomeItems    Item[]                @relation("ItemIncome")
  expenseItems   Item[]                @relation("ItemExpense")
  inventoryItems Item[]                @relation("ItemInventory")
  cogsItems      Item[]                @relation("ItemCogs")
  /// Composite key: a parent always belongs to the same organisation, enforced by the database
  parent         Account?              @relation("AccountTree", fields: [organizationId, parentId], references: [organizationId, id], onDelete: NoAction)
  children       Account[]             @relation("AccountTree")
  taxOutputs     TaxRate[]             @relation("TaxOutputAccount")
  taxInputs      TaxRate[]             @relation("TaxInputAccount")
  lines          JournalLine[]

  invoiceReceivables    Invoice[]                 @relation("InvoiceReceivable")
  invoiceIncome         InvoiceLine[]             @relation("InvoiceLineAccount")
  quoteIncome           QuoteLine[]               @relation("QuoteLineAccount")
  creditNoteReceivables CreditNote[]              @relation("CreditNoteReceivable")
  creditNoteIncome      CreditNoteLine[]          @relation("CreditNoteLineAccount")
  creditRefundBanks     CreditApplication[]       @relation("CreditRefundBank")
  vendorCreditPayables  VendorCredit[]            @relation("VendorCreditPayable")
  vendorCreditExpense   VendorCreditLine[]        @relation("VendorCreditLineAccount")
  vendorRefundBanks     VendorCreditApplication[] @relation("VendorRefundBank")
  bankTransactions      BankTransaction[]         @relation("BankTransactionAccount")
  bankTransfersIn       BankTransaction[]         @relation("BankTransferTo")
  statementImports      BankStatementImport[]
  statementLines        BankStatementLine[]
  statementLayout       BankStatementLayout?
  reconciliations       BankReconciliation[]
  assetsAt              FixedAsset[]              @relation("AssetCostAccount")
  assetsDepreciatedIn   FixedAsset[]              @relation("AssetAccumulatedAccount")
  assetsExpensedTo      FixedAsset[]              @relation("AssetExpenseAccount")
  budgetLines           BudgetLine[]

  paymentBanks Payment[] @relation("PaymentBank")
  paymentsTds  Payment[] @relation("PaymentTds")

  billPayables Bill[]     @relation("BillPayable")
  billExpenses BillLine[] @relation("BillLineAccount")

  @@unique([organizationId, id])
  @@unique([organizationId, code])
  @@unique([organizationId, systemKey])
  @@unique([organizationId, id, currency])
  @@index([organizationId, parentId])
  @@map("accounts")
}

/// A financial year, split into monthly periods. Years follow on from each other without gaps.
model FiscalYear {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  name           String /// e.g. FY 2026–27
  startDate      DateTime @map("start_date") @db.Date
  endDate        DateTime @map("end_date") @db.Date
  createdAt      DateTime @default(now()) @map("created_at")
  /// The entry that moved the year's profit to retained earnings when its last month closed (none if there was nothing to move)
  closingEntryId String?  @map("closing_entry_id") @db.Uuid

  organization Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  periods      Period[]
  journals     JournalEntry[] @relation("FiscalYearEntries")
  closingEntry JournalEntry?  @relation("YearClosingEntry", fields: [organizationId, closingEntryId], references: [organizationId, id], onDelete: NoAction)

  invoices      Invoice[]
  creditNotes   CreditNote[]
  vendorCredits VendorCredit[]
  budgets       Budget[]

  payments Payment[]

  bills Bill[]

  @@unique([organizationId, id])
  @@unique([organizationId, startDate])
  @@unique([organizationId, closingEntryId])
  @@map("fiscal_years")
}

/// A month of a financial year. A closed period accepts no new, changed or reversed entries.
model Period {
  id             String    @id @default(uuid()) @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  fiscalYearId   String    @map("fiscal_year_id") @db.Uuid
  number         Int /// 1–12 within the year
  startDate      DateTime  @map("start_date") @db.Date
  endDate        DateTime  @map("end_date") @db.Date
  status         String    @default("open") /// open | closed
  closedAt       DateTime? @map("closed_at")
  closedById     String?   @map("closed_by_id") @db.Uuid
  closeReason    String?   @map("close_reason")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  /// Composite key: a period always belongs to a year of the same organisation
  fiscalYear   FiscalYear   @relation(fields: [organizationId, fiscalYearId], references: [organizationId, id], onDelete: Cascade)
  closedBy     User?        @relation("PeriodClosedBy", fields: [closedById], references: [id], onDelete: SetNull)

  @@unique([fiscalYearId, number])
  @@index([organizationId, startDate])
  @@map("periods")
}

/// A double-entry journal entry. Drafts can change freely; posted entries never change (a reversal corrects them).
model JournalEntry {
  id             String    @id @default(uuid()) @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  /// Gap-free per financial year, assigned when posted
  number         Int?
  fiscalYearId   String?   @map("fiscal_year_id") @db.Uuid
  date           DateTime  @db.Date
  memo           String?
  reference      String?
  status         String    @default("draft") /// draft | posted
  /// For a reversal: the entry it reverses
  reversalOfId   String?   @map("reversal_of_id") @db.Uuid
  createdById    String?   @map("created_by_id") @db.Uuid
  postedById     String?   @map("posted_by_id") @db.Uuid
  postedAt       DateTime? @map("posted_at")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  organization Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  fiscalYear   FiscalYear?         @relation("FiscalYearEntries", fields: [organizationId, fiscalYearId], references: [organizationId, id], onDelete: NoAction)
  closesYear   FiscalYear?         @relation("YearClosingEntry")
  reversalOf   JournalEntry?       @relation("Reversal", fields: [organizationId, reversalOfId], references: [organizationId, id], onDelete: NoAction)
  reversedBy   JournalEntry?       @relation("Reversal")
  createdBy    User?               @relation("JournalCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  postedBy     User?               @relation("JournalPostedBy", fields: [postedById], references: [id], onDelete: SetNull)
  lines        JournalLine[]
  attachments  JournalAttachment[]

  invoice       Invoice? @relation("InvoiceEntry")
  voidedInvoice Invoice? @relation("InvoiceVoidEntry")

  payment       Payment? @relation("PaymentEntry")
  voidedPayment Payment? @relation("PaymentVoidEntry")

  bill       Bill? @relation("BillEntry")
  voidedBill Bill? @relation("BillVoidEntry")

  creditNote            CreditNote?              @relation("CreditNoteEntry")
  voidedCreditNote      CreditNote?              @relation("CreditNoteVoidEntry")
  creditRefund          CreditApplication?       @relation("CreditRefundEntry")
  vendorCredit          VendorCredit?            @relation("VendorCreditEntry")
  voidedVendorCredit    VendorCredit?            @relation("VendorCreditVoidEntry")
  vendorRefund          VendorCreditApplication? @relation("VendorRefundEntry")
  bankTransaction       BankTransaction?         @relation("BankTransactionEntry")
  voidedBankTransaction BankTransaction?         @relation("BankTransactionVoidEntry")
  depreciationRun       DepreciationRun?         @relation("DepreciationEntry")
  stockMovements        StockMovement[]
  assetDisposal         FixedAsset?              @relation("AssetDisposalEntry")

  @@unique([organizationId, id])
  @@unique([organizationId, fiscalYearId, number])
  /// An entry is reversed at most once
  @@unique([organizationId, reversalOfId])
  @@index([organizationId, date])
  @@index([organizationId, status])
  @@map("journal_entries")
}

/// One debit or credit. Amounts are integers in the smallest currency unit.
model JournalLine {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  entryId        String   @map("entry_id") @db.Uuid
  lineNo         Int      @map("line_no")
  accountId      String   @map("account_id") @db.Uuid
  description    String?
  debit          BigInt   @default(0)
  credit         BigInt   @default(0)
  /// The tax group charged on this line (its amount is then the net value)
  taxGroupId     String?  @map("tax_group_id") @db.Uuid
  /// Whether the amount entered included the tax (kept so the draft can be edited as entered)
  taxInclusive   Boolean  @default(false) @map("tax_inclusive")
  /// Set on a tax line the system generated: the rate it charges, and the line it was charged on
  taxRateId      String?  @map("tax_rate_id") @db.Uuid
  taxSourceLine  Int?     @map("tax_source_line")
  /// A line on a foreign-currency account: the amount in that currency and the rate it was converted at
  currency       String?  @db.Char(3)
  foreignDebit   BigInt   @default(0) @map("foreign_debit")
  foreignCredit  BigInt   @default(0) @map("foreign_credit")
  rate           Decimal? @db.Decimal(20, 10)
  /// Set on an exchange-difference line generated on posting: the line whose settlement it records
  fxSourceLine   Int?     @map("fx_source_line")
  /// The cost centre or project the line belongs to
  costCentreId   String?  @map("cost_centre_id") @db.Uuid

  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  costCentre      CostCentre?  @relation(fields: [organizationId, costCentreId], references: [organizationId, id], onDelete: NoAction)
  entry           JournalEntry @relation(fields: [organizationId, entryId], references: [organizationId, id], onDelete: Cascade)
  taxGroup        TaxGroup?    @relation(fields: [organizationId, taxGroupId], references: [organizationId, id], onDelete: NoAction)
  taxRate         TaxRate?     @relation(fields: [organizationId, taxRateId], references: [organizationId, id], onDelete: NoAction)
  /// A foreign line's currency must be its account's (the database checks; base lines have no currency)
  currencyAccount Account?     @relation("LineCurrency", fields: [organizationId, accountId, currency], references: [organizationId, id, currency], onDelete: NoAction)
  /// Composite key: a line can only use an account of its own organisation
  account         Account      @relation(fields: [organizationId, accountId], references: [organizationId, id], onDelete: NoAction)

  bankMatch BankMatch?

  @@unique([organizationId, id])
  @@unique([entryId, lineNo])
  @@index([organizationId, accountId])
  @@index([organizationId, costCentreId])
  @@map("journal_lines")
}

/// A supporting document (receipt, invoice scan) attached to an entry.
model JournalAttachment {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  entryId        String   @map("entry_id") @db.Uuid
  fileName       String   @map("file_name")
  contentType    String   @map("content_type")
  size           Int
  data           Bytes
  uploadedById   String?  @map("uploaded_by_id") @db.Uuid
  createdAt      DateTime @default(now()) @map("created_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  entry        JournalEntry @relation(fields: [organizationId, entryId], references: [organizationId, id], onDelete: Cascade)

  @@index([entryId])
  @@map("journal_attachments")
}

/// A custom role defined by an organisation. Built-in roles live in @ledgernest/shared, not here.
model Role {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  name           String
  description    String?
  permissions    String[] /// keys from @ledgernest/shared, validated on write
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  memberships  Membership[]
  invitations  Invitation[]

  @@unique([organizationId, name])
  @@map("roles")
}

/// A user's place in an organisation: either a built-in role key or a custom role.
model Membership {
  id             String   @id @default(uuid()) @db.Uuid
  userId         String   @map("user_id") @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  builtInRole    String?  @map("built_in_role") /// owner | admin | accountant | bookkeeper | auditor | viewer
  customRoleId   String?  @map("custom_role_id") @db.Uuid
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  customRole   Role?        @relation(fields: [customRoleId], references: [id], onDelete: Restrict)

  @@unique([userId, organizationId])
  @@index([organizationId])
  @@map("memberships")
}

/// An emailed invitation to join an organisation. Only a hash of the token is stored.
model Invitation {
  id             String    @id @default(uuid()) @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  email          String
  builtInRole    String?   @map("built_in_role")
  customRoleId   String?   @map("custom_role_id") @db.Uuid
  tokenHash      String    @unique @map("token_hash")
  expiresAt      DateTime  @map("expires_at")
  acceptedAt     DateTime? @map("accepted_at")
  revokedAt      DateTime? @map("revoked_at")
  invitedById    String    @map("invited_by_id") @db.Uuid
  createdAt      DateTime  @default(now()) @map("created_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  invitedBy    User         @relation("InvitedBy", fields: [invitedById], references: [id])
  /// Deleting a custom role withdraws pending invitations for it
  customRole   Role?        @relation(fields: [customRoleId], references: [id], onDelete: Cascade)

  @@index([organizationId, email])
  @@map("invitations")
}

/// Append-only record of who did what. Never updated or deleted by the application.
model AuditLog {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String?  @map("organization_id") @db.Uuid /// null for platform-level actions
  actorId        String?  @map("actor_id") @db.Uuid /// null for system actions
  /// Who did it, copied from the user when the entry is written (kept even if the user is later deleted)
  actorEmail     String?  @map("actor_email")
  action         String /// e.g. organization.create, user.login.failed
  entityType     String?  @map("entity_type")
  entityId       String?  @map("entity_id")
  before         Json?
  after          Json?
  ip             String?
  userAgent      String?  @map("user_agent")
  createdAt      DateTime @default(now()) @map("created_at")

  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  actor        User?         @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([organizationId, createdAt(sort: Desc)])
  @@index([actorId, createdAt(sort: Desc)])
  @@index([createdAt(sort: Desc)])
  @@map("audit_logs")
}

/// One refresh token in a rotation chain. Only the SHA-256 hash is stored.
/// All tokens from one sign-in share a familyId; reusing an old token revokes the whole family.
/// A password reset link: only the token's hash is kept; it works once, for a short time
model PasswordReset {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  ip        String?
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("password_resets")
}

model RefreshToken {
  id           String    @id @default(uuid()) @db.Uuid
  userId       String    @map("user_id") @db.Uuid
  familyId     String    @map("family_id") @db.Uuid
  tokenHash    String    @unique @map("token_hash")
  expiresAt    DateTime  @map("expires_at")
  revokedAt    DateTime? @map("revoked_at")
  replacedById String?   @map("replaced_by_id") @db.Uuid
  ip           String?
  userAgent    String?   @map("user_agent")
  createdAt    DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([familyId])
  @@index([userId])
  @@map("refresh_tokens")
}

/// A GST slab India's GST Council has set (0%, 5%, 18%, 40%…). Platform-wide and managed by the Super Admin;
/// organisations build their tax groups from it. A rate never changes: a slab is retired with an end date.
model GstSlab {
  id            String    @id @default(uuid()) @db.Uuid
  ratePpm       Int       @map("rate_ppm") /// parts per million: 180000 = 18%
  label         String
  description   String?
  effectiveFrom DateTime  @map("effective_from") @db.Date
  effectiveTo   DateTime? @map("effective_to") @db.Date
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  groups TaxGroup[]

  @@index([effectiveFrom])
  @@map("gst_slabs")
}

/// One tax component (CGST 9%, VAT 20%) and the accounts it posts to.
model TaxRate {
  id              String    @id @default(uuid()) @db.Uuid
  organizationId  String    @map("organization_id") @db.Uuid
  name            String
  kind            String /// cgst | sgst | utgst | igst | cess | vat | sales_tax | other
  ratePpm         Int       @map("rate_ppm")
  outputAccountId String    @map("output_account_id") @db.Uuid /// tax on sales, a liability
  inputAccountId  String?   @map("input_account_id") @db.Uuid /// tax on purchases, an asset (input credit)
  archivedAt      DateTime? @map("archived_at")
  createdAt       DateTime  @default(now()) @map("created_at")

  organization  Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  outputAccount Account        @relation("TaxOutputAccount", fields: [organizationId, outputAccountId], references: [organizationId, id], onDelete: NoAction)
  inputAccount  Account?       @relation("TaxInputAccount", fields: [organizationId, inputAccountId], references: [organizationId, id], onDelete: NoAction)
  groups        TaxGroupRate[]
  lines         JournalLine[]

  @@unique([organizationId, id])
  @@map("tax_rates")
}

/// What a line picks: one or more rates charged together (GST 18% = CGST 9% + SGST 9%).
model TaxGroup {
  id             String    @id @default(uuid()) @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  name           String
  gstSlabId      String?   @map("gst_slab_id") @db.Uuid /// set when made from a GST slab
  supply         String? /// intra | inter, for GST groups
  archivedAt     DateTime? @map("archived_at")
  createdAt      DateTime  @default(now()) @map("created_at")

  organization Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  gstSlab      GstSlab?       @relation(fields: [gstSlabId], references: [id], onDelete: Restrict)
  rates        TaxGroupRate[]
  lines        JournalLine[]
  items        Item[]

  invoiceLines      InvoiceLine[]
  rcmInvoiceLines   InvoiceLine[]      @relation("InvoiceLineRcmGroup")
  quoteLines        QuoteLine[]
  creditNoteLines   CreditNoteLine[]
  vendorCreditLines VendorCreditLine[]

  billLines    BillLine[]
  rcmBillLines BillLine[] @relation("BillLineRcmGroup")

  @@unique([organizationId, id])
  @@unique([organizationId, gstSlabId, supply])
  @@map("tax_groups")
}

model TaxGroupRate {
  organizationId String @map("organization_id") @db.Uuid
  groupId        String @map("group_id") @db.Uuid
  rateId         String @map("rate_id") @db.Uuid
  position       Int

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  group        TaxGroup     @relation(fields: [organizationId, groupId], references: [organizationId, id], onDelete: Cascade)
  rate         TaxRate      @relation(fields: [organizationId, rateId], references: [organizationId, id], onDelete: NoAction)

  @@id([groupId, rateId])
  @@index([organizationId, rateId])
  @@map("tax_group_rates")
}

/// A foreign currency an organisation trades in. The base currency is never in this list.
model OrganizationCurrency {
  organizationId String   @map("organization_id") @db.Uuid
  code           String   @db.Char(3)
  createdAt      DateTime @default(now()) @map("created_at")

  organization Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  rates        ExchangeRate[]
  accounts     Account[]
  contacts     Contact[]

  @@id([organizationId, code])
  @@map("organization_currencies")
}

/// "1 unit of the currency = rate units of the base currency" on a day. A day without a rate uses the latest before it.
model ExchangeRate {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  currency       String   @db.Char(3)
  date           DateTime @db.Date
  rate           Decimal  @db.Decimal(20, 10)
  /// manual | ecb (fetched from the European Central Bank's reference rates)
  source         String
  createdById    String?  @map("created_by_id") @db.Uuid
  updatedAt      DateTime @updatedAt @map("updated_at")

  organization Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  orgCurrency  OrganizationCurrency @relation(fields: [organizationId, currency], references: [organizationId, code], onDelete: Cascade)

  @@unique([organizationId, currency, date])
  @@map("exchange_rates")
}

/// A customer, a vendor or both.
model Contact {
  id               String    @id @default(uuid()) @db.Uuid
  organizationId   String    @map("organization_id") @db.Uuid
  name             String
  isCustomer       Boolean   @map("is_customer")
  isVendor         Boolean   @map("is_vendor")
  legalName        String?   @map("legal_name")
  /// GSTIN, VAT number, EIN…
  taxId            String?   @map("tax_id")
  email            String?
  phone            String?
  /// { line1, line2, city, region, postalCode, country }
  billingAddress   Json      @map("billing_address")
  /// null = same as billing
  shippingAddress  Json?     @map("shipping_address")
  /// GST state code for the place of supply (from the GSTIN, else the address); null outside India
  stateCode        String?   @map("state_code") @db.Char(2)
  /// Invoices and bills in this currency by default; null = the base currency
  currency         String?   @db.Char(3)
  paymentTermsDays Int       @default(30) @map("payment_terms_days")
  /// The most a customer may owe us, in their currency's smallest unit; null = no limit
  creditLimit      BigInt?   @map("credit_limit")
  /// MSME category from the vendor's Udyam certificate (micro, small or medium); null = not an MSME
  msmeCategory     String?   @map("msme_category")
  /// How GST treats them: registered | composition | sez | unregistered | consumer | overseas | uin; null = from the GSTIN and country
  gstTreatment     String?   @map("gst_treatment")
  /// Their PAN, for TDS; null = from the GSTIN
  pan              String?
  /// The account they're paid into { accountName, accountNumber, ifsc, bankName, branch, accountType }
  bankDetails      Json?     @map("bank_details")
  /// The number to WhatsApp them on, when it isn't the phone
  whatsapp         String?
  /// People to deal with there [{ name, designation, email, phone, whatsapp, primary }]
  persons          Json      @default("[]")
  /// More delivery addresses, each with a label
  shipAddresses    Json      @default("[]") @map("ship_addresses")
  /// The TDS section their payments usually fall under
  tdsSection       String?   @map("tds_section")
  udyamNumber      String?   @map("udyam_number")
  /// Interest on this customer's late payments, basis points a year: null = the organisation's, 0 = none
  interestRateBp   Int?      @map("interest_rate_bp")
  notes            String?
  /// A link the customer opens without signing in: what they owe across invoices, to pay by UPI (random, revocable)
  shareToken       String?   @unique @map("share_token")
  shareViews       Int       @default(0) @map("share_views")
  shareViewedAt    DateTime? @map("share_viewed_at")
  /// When we last chased this customer for what's overdue (WhatsApp or email)
  lastChasedAt     DateTime? @map("last_chased_at")
  archivedAt       DateTime? @map("archived_at")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  organization Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  orgCurrency  OrganizationCurrency? @relation(fields: [organizationId, currency], references: [organizationId, code], onDelete: NoAction)

  invoices             Invoice[]
  creditNotes          CreditNote[]
  vendorCredits        VendorCredit[]
  recurringInvoices    RecurringInvoice[]
  quotes               Quote[]
  recurringBills       RecurringBill[]
  bankTransactions     BankTransaction[]
  balanceConfirmations BalanceConfirmation[]

  payments Payment[]

  bills Bill[]

  @@unique([organizationId, id])
  @@index([organizationId, archivedAt])
  @@map("contacts")
}

/// A product or service to put on invoices and bills.
model Item {
  id                 String    @id @default(uuid()) @db.Uuid
  organizationId     String    @map("organization_id") @db.Uuid
  name               String
  kind               String /// goods | service
  sku                String?
  description        String?
  unit               String?
  /// In the base currency's smallest unit
  salePrice          BigInt?   @map("sale_price")
  purchasePrice      BigInt?   @map("purchase_price")
  taxGroupId         String?   @map("tax_group_id") @db.Uuid
  /// HSN (goods) or SAC (services), for Indian GST invoices
  hsnSac             String?   @map("hsn_sac")
  incomeAccountId    String?   @map("income_account_id") @db.Uuid
  expenseAccountId   String?   @map("expense_account_id") @db.Uuid
  /// Goods whose quantity on hand is kept, at weighted average cost
  trackStock         Boolean   @default(false) @map("track_stock")
  /// Tracked goods kept in batches with manufacturing and expiry dates
  trackBatches       Boolean   @default(false) @map("track_batches")
  /// Tracked goods whose every unit has its own serial number
  trackSerials       Boolean   @default(false) @map("track_serials")
  /// Input tax credit on it is blocked (CGST Act s.17(5)): e.g. cars, food, club memberships; its GST is part of the cost
  itcBlocked         Boolean   @default(false) @map("itc_blocked")
  /// A second unit it's also sold or bought in (e.g. BOX), and how many of the main unit make one
  altUnit            String?   @map("alt_unit")
  altFactor          Decimal?  @map("alt_factor") @db.Decimal(13, 4)
  inventoryAccountId String?   @map("inventory_account_id") @db.Uuid
  cogsAccountId      String?   @map("cogs_account_id") @db.Uuid
  /// Stock at or below this is low (tracked goods only)
  reorderLevel       Decimal?  @map("reorder_level") @db.Decimal(13, 4)
  /// Maximum retail price, tax included, in paise (Legal Metrology)
  mrp                BigInt?
  /// The barcode on the pack; unique in the organisation
  barcode            String?
  brand              String?
  category           String?
  archivedAt         DateTime? @map("archived_at")
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @updatedAt @map("updated_at")

  organization     Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  taxGroup         TaxGroup?       @relation(fields: [organizationId, taxGroupId], references: [organizationId, id], onDelete: NoAction)
  incomeAccount    Account?        @relation("ItemIncome", fields: [organizationId, incomeAccountId], references: [organizationId, id], onDelete: NoAction)
  expenseAccount   Account?        @relation("ItemExpense", fields: [organizationId, expenseAccountId], references: [organizationId, id], onDelete: NoAction)
  inventoryAccount Account?        @relation("ItemInventory", fields: [organizationId, inventoryAccountId], references: [organizationId, id], onDelete: NoAction)
  cogsAccount      Account?        @relation("ItemCogs", fields: [organizationId, cogsAccountId], references: [organizationId, id], onDelete: NoAction)
  stockMovements   StockMovement[]
  batches          StockBatch[]
  serials          StockSerial[]

  invoiceLines InvoiceLine[]
  quoteLines   QuoteLine[]

  billLines BillLine[]

  @@unique([organizationId, id])
  @@unique([organizationId, sku])
  @@unique([organizationId, barcode])
  @@index([organizationId, category])
  @@index([organizationId, archivedAt])
  @@map("items")
}

/// A sales invoice. Drafts change freely; issuing gives it a number and posts its journal entry.
model Invoice {
  id                  String    @id @default(uuid()) @db.Uuid
  organizationId      String    @map("organization_id") @db.Uuid
  contactId           String    @map("contact_id") @db.Uuid
  /// Gap-free per financial year, given on issue
  number              Int?
  /// The series that numbered it, and the number as written (kept, so changing the series never renumbers it)
  seriesId            String?   @map("series_id") @db.Uuid
  fullNumber          String?   @map("full_number")
  /// Interest terms: on a draft, a rate chosen for it (null = the default); once issued, the terms it was issued with
  interestRateBp      Int?      @map("interest_rate_bp")
  interestMethod      String?   @map("interest_method")
  interestGraceDays   Int?      @map("interest_grace_days")
  /// For an invoice raised for interest on late payment: the invoice the interest is on
  interestOnInvoiceId String?   @map("interest_on_invoice_id") @db.Uuid
  /// Paid in instalments: [{ dueDate, amount }], adding up to the total; null = all on the due date
  instalments         Json?
  /// Order and dispatch details: buyer's order, delivery note, transporter, LR, vehicle, destination, terms
  dispatch            Json?
  /// Where the goods go, when not the customer's billing address: { name, line1, line2, city, region, postalCode, country }
  shipTo              Json?     @map("ship_to")
  fiscalYearId        String?   @map("fiscal_year_id") @db.Uuid
  status              String    @default("draft") /// draft | issued | void
  issueDate           DateTime  @map("issue_date") @db.Date
  dueDate             DateTime  @map("due_date") @db.Date
  /// null = the base currency
  currency            String?   @db.Char(3)
  /// For a foreign-currency invoice: the rate it was posted at
  rate                Decimal?  @db.Decimal(20, 10)
  /// GST state code of the place of supply
  placeOfSupply       String?   @map("place_of_supply") @db.Char(2)
  reference           String?
  notes               String?
  receivableAccountId String?   @map("receivable_account_id") @db.Uuid
  /// The schedule that raised it, if any
  recurringInvoiceId  String?   @map("recurring_invoice_id") @db.Uuid
  /// In the invoice currency's smallest unit
  subtotal            BigInt    @default(0)
  taxTotal            BigInt    @default(0) @map("tax_total")
  /// The total rounded to the rupee: the difference (smallest unit)
  roundOff            BigInt    @default(0) @map("round_off")
  /// Prices include GST, taken out of each line
  pricesIncludeTax    Boolean   @default(false) @map("prices_include_tax")
  /// A discount on the whole invoice: { kind: percent | amount, value } (ppm or smallest unit)
  discount            Json?
  /// What that discount came to, spread over the lines before tax
  discountTotal       BigInt    @default(0) @map("discount_total")
  /// regular | export_with_igst | export_lut | sez_with_igst | sez_lut | deemed_export
  supplyKind          String    @default("regular") @map("supply_kind")
  /// For an export: { portCode, shippingBillNo, shippingBillDate, countryCode }
  exportDetails       Json?     @map("export_details")
  /// The buyer pays the GST under reverse charge (CGST Act s.9(3)): none is charged here
  reverseCharge       Boolean   @default(false) @map("reverse_charge")
  total               BigInt    @default(0)
  amountPaid          BigInt    @default(0) @map("amount_paid")
  journalEntryId      String?   @map("journal_entry_id") @db.Uuid
  voidEntryId         String?   @map("void_entry_id") @db.Uuid
  createdById         String?   @map("created_by_id") @db.Uuid
  issuedAt            DateTime? @map("issued_at")
  voidedAt            DateTime? @map("voided_at")
  /// When a payment reminder last went to the customer, and how many have
  lastRemindedAt      DateTime? @map("last_reminded_at")
  reminders           Int       @default(0)
  /// A link the customer opens without signing in (random, revocable), and how often it was opened
  shareToken          String?   @unique @map("share_token")
  shareViews          Int       @default(0) @map("share_views")
  shareViewedAt       DateTime? @map("share_viewed_at")
  /// From the e-invoice portal once registered: the IRN, its acknowledgement and the signed QR to print
  irn                 String?   @map("irn")
  irnAckNo            String?   @map("irn_ack_no")
  irnAckDate          String?   @map("irn_ack_date")
  irnSignedQr         String?   @map("irn_signed_qr")
  createdAt           DateTime  @default(now()) @map("created_at")
  updatedAt           DateTime  @updatedAt @map("updated_at")

  organization      Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  contact           Contact       @relation(fields: [organizationId, contactId], references: [organizationId, id], onDelete: NoAction)
  fiscalYear        FiscalYear?   @relation(fields: [organizationId, fiscalYearId], references: [organizationId, id], onDelete: NoAction)
  series            NumberSeries? @relation(fields: [organizationId, seriesId], references: [organizationId, id], onDelete: NoAction)
  receivableAccount Account?      @relation("InvoiceReceivable", fields: [organizationId, receivableAccountId], references: [organizationId, id], onDelete: NoAction)
  journalEntry      JournalEntry? @relation("InvoiceEntry", fields: [organizationId, journalEntryId], references: [organizationId, id], onDelete: NoAction)
  voidEntry         JournalEntry? @relation("InvoiceVoidEntry", fields: [organizationId, voidEntryId], references: [organizationId, id], onDelete: NoAction)
  lines             InvoiceLine[]

  allocations PaymentAllocation[]
  creditNotes CreditNote[]
  quotes      Quote[]
  credits     CreditApplication[]
  recurring   RecurringInvoice?   @relation(fields: [organizationId, recurringInvoiceId], references: [organizationId, id], onDelete: NoAction)

  interestWaivers InterestWaiver[]

  @@unique([organizationId, id])
  @@unique([organizationId, fiscalYearId, fullNumber])
  @@unique([seriesId, fiscalYearId, number])
  @@unique([organizationId, journalEntryId])
  @@unique([organizationId, voidEntryId])
  @@index([organizationId, contactId])
  @@index([organizationId, interestOnInvoiceId])
  @@index([organizationId, recurringInvoiceId])
  @@index([organizationId, status, dueDate])
  @@map("invoices")
}

model InvoiceLine {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  invoiceId      String   @map("invoice_id") @db.Uuid
  lineNo         Int      @map("line_no")
  itemId         String?  @map("item_id") @db.Uuid
  description    String
  quantity       Decimal  @db.Decimal(13, 4)
  /// The quantity and price are in the item's second unit
  inAltUnit      Boolean  @default(false) @map("in_alt_unit")
  /// The serial numbers of the units sold (goods with serial numbers)
  serials        String[] @default([])
  /// The batch chosen to sell from (goods kept in batches); null = earliest expiry first
  batchId        String?  @map("batch_id") @db.Uuid
  unitPrice      BigInt   @map("unit_price")
  discountPpm    Int      @default(0) @map("discount_ppm")
  taxGroupId     String?  @map("tax_group_id") @db.Uuid
  /// Under reverse charge: the GST the buyer pays (the line itself carries none)
  rcmTaxGroupId  String?  @map("rcm_tax_group_id") @db.Uuid
  accountId      String?  @map("account_id") @db.Uuid
  /// Worked out from the above: net of discount, and its tax
  amount         BigInt
  taxAmount      BigInt   @default(0) @map("tax_amount")
  costCentreId   String?  @map("cost_centre_id") @db.Uuid

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  costCentre   CostCentre?  @relation(fields: [organizationId, costCentreId], references: [organizationId, id], onDelete: NoAction)
  invoice      Invoice      @relation(fields: [organizationId, invoiceId], references: [organizationId, id], onDelete: Cascade)
  item         Item?        @relation(fields: [organizationId, itemId], references: [organizationId, id], onDelete: NoAction)
  taxGroup     TaxGroup?    @relation(fields: [organizationId, taxGroupId], references: [organizationId, id], onDelete: NoAction)
  rcmTaxGroup  TaxGroup?    @relation("InvoiceLineRcmGroup", fields: [organizationId, rcmTaxGroupId], references: [organizationId, id], onDelete: NoAction)
  account      Account?     @relation("InvoiceLineAccount", fields: [organizationId, accountId], references: [organizationId, id], onDelete: NoAction)

  credited CreditNoteLine[]

  @@unique([organizationId, id])
  @@unique([invoiceId, lineNo])
  @@map("invoice_lines")
}

/// Money in from a customer (receipt) or out to a vendor (payment), allocated to what it settles.
model Payment {
  id             String    @id @default(uuid()) @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  kind           String /// receipt | payment
  number         Int
  fiscalYearId   String    @map("fiscal_year_id") @db.Uuid
  status         String    @default("posted") /// posted | void
  contactId      String    @map("contact_id") @db.Uuid
  date           DateTime  @db.Date
  bankAccountId  String    @map("bank_account_id") @db.Uuid
  /// The documents' currency; null = the base currency
  currency       String?   @db.Char(3)
  rate           Decimal?  @db.Decimal(20, 10)
  /// In that currency's smallest unit
  amount         BigInt
  allocated      BigInt    @default(0)
  /// Tax deducted at source on a vendor payment: the section, rate, what it's on, what was kept back and where it's owed
  tdsSection     String?   @map("tds_section")
  tdsRatePpm     Int?      @map("tds_rate_ppm")
  tdsBase        BigInt?   @map("tds_base")
  tdsAmount      BigInt    @default(0) @map("tds_amount")
  tdsAccountId   String?   @map("tds_account_id") @db.Uuid
  reference      String?
  notes          String?
  journalEntryId String    @map("journal_entry_id") @db.Uuid
  voidEntryId    String?   @map("void_entry_id") @db.Uuid
  createdById    String?   @map("created_by_id") @db.Uuid
  createdAt      DateTime  @default(now()) @map("created_at")
  voidedAt       DateTime? @map("voided_at")

  organization Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  contact      Contact             @relation(fields: [organizationId, contactId], references: [organizationId, id], onDelete: NoAction)
  fiscalYear   FiscalYear          @relation(fields: [organizationId, fiscalYearId], references: [organizationId, id], onDelete: NoAction)
  bankAccount  Account             @relation("PaymentBank", fields: [organizationId, bankAccountId], references: [organizationId, id], onDelete: NoAction)
  tdsAccount   Account?            @relation("PaymentTds", fields: [organizationId, tdsAccountId], references: [organizationId, id], onDelete: NoAction)
  journalEntry JournalEntry        @relation("PaymentEntry", fields: [organizationId, journalEntryId], references: [organizationId, id], onDelete: NoAction)
  voidEntry    JournalEntry?       @relation("PaymentVoidEntry", fields: [organizationId, voidEntryId], references: [organizationId, id], onDelete: NoAction)
  allocations  PaymentAllocation[]

  @@unique([organizationId, id])
  @@unique([organizationId, kind, fiscalYearId, number])
  @@unique([organizationId, journalEntryId])
  @@unique([organizationId, voidEntryId])
  @@index([organizationId, contactId])
  @@map("payments")
}

model PaymentAllocation {
  id             String  @id @default(uuid()) @db.Uuid
  organizationId String  @map("organization_id") @db.Uuid
  paymentId      String  @map("payment_id") @db.Uuid
  /// A receipt settles an invoice; a payment settles a bill (exactly one is set)
  invoiceId      String? @map("invoice_id") @db.Uuid
  billId         String? @map("bill_id") @db.Uuid
  amount         BigInt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  payment      Payment      @relation(fields: [organizationId, paymentId], references: [organizationId, id], onDelete: Cascade)
  invoice      Invoice?     @relation(fields: [organizationId, invoiceId], references: [organizationId, id], onDelete: NoAction)
  bill         Bill?        @relation(fields: [organizationId, billId], references: [organizationId, id], onDelete: NoAction)

  @@unique([paymentId, invoiceId])
  @@unique([paymentId, billId])
  @@index([organizationId, invoiceId])
  @@index([organizationId, billId])
  @@map("payment_allocations")
}

/// A vendor's bill. Drafts change freely; recording it gives it a number and posts its entry.
model Bill {
  id                String    @id @default(uuid()) @db.Uuid
  organizationId    String    @map("organization_id") @db.Uuid
  contactId         String    @map("contact_id") @db.Uuid
  number            Int?
  fiscalYearId      String?   @map("fiscal_year_id") @db.Uuid
  status            String    @default("draft") /// draft | open | void
  /// The vendor's own number for it
  vendorReference   String?   @map("vendor_reference")
  /// The date on the vendor's bill (GSTR-2B shows it); null = the bill date
  vendorBillDate    DateTime? @map("vendor_bill_date") @db.Date
  /// We pay the GST under reverse charge (CGST Act s.9(3)/(4), IGST Act s.5(3)): the vendor charges none
  reverseCharge     Boolean   @default(false) @map("reverse_charge")
  /// Under reverse charge from an unregistered vendor: the self-invoice we raise (CGST Act s.31(3)(f)), numbered SI/<FY>/NNNN
  selfInvoiceNumber String?   @map("self_invoice_number")
  /// Goods imported: the bill of entry customs assessed { number, date, portCode }; its taxed lines are the assessable value (IGST on it goes to customs, the value to the supplier), its untaxed lines the duties
  billOfEntry       Json?     @map("bill_of_entry")
  /// When it's entered in the books
  billDate          DateTime  @map("bill_date") @db.Date
  dueDate           DateTime  @map("due_date") @db.Date
  currency          String?   @db.Char(3)
  rate              Decimal?  @db.Decimal(20, 10)
  placeOfSupply     String?   @map("place_of_supply") @db.Char(2)
  notes             String?
  payableAccountId  String?   @map("payable_account_id") @db.Uuid
  subtotal          BigInt    @default(0)
  taxTotal          BigInt    @default(0) @map("tax_total")
  total             BigInt    @default(0)
  amountPaid        BigInt    @default(0) @map("amount_paid")
  journalEntryId    String?   @map("journal_entry_id") @db.Uuid
  voidEntryId       String?   @map("void_entry_id") @db.Uuid
  createdById       String?   @map("created_by_id") @db.Uuid
  recordedAt        DateTime? @map("recorded_at")
  /// The schedule that made it
  recurringBillId   String?   @map("recurring_bill_id") @db.Uuid
  voidedAt          DateTime? @map("voided_at")
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")

  organization             Organization              @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  contact                  Contact                   @relation(fields: [organizationId, contactId], references: [organizationId, id], onDelete: NoAction)
  fiscalYear               FiscalYear?               @relation(fields: [organizationId, fiscalYearId], references: [organizationId, id], onDelete: NoAction)
  payableAccount           Account?                  @relation("BillPayable", fields: [organizationId, payableAccountId], references: [organizationId, id], onDelete: NoAction)
  journalEntry             JournalEntry?             @relation("BillEntry", fields: [organizationId, journalEntryId], references: [organizationId, id], onDelete: NoAction)
  voidEntry                JournalEntry?             @relation("BillVoidEntry", fields: [organizationId, voidEntryId], references: [organizationId, id], onDelete: NoAction)
  lines                    BillLine[]
  vendorCredits            VendorCredit[]
  vendorCreditApplications VendorCreditApplication[]

  allocations PaymentAllocation[]
  recurring   RecurringBill?      @relation(fields: [organizationId, recurringBillId], references: [organizationId, id], onDelete: NoAction)

  @@unique([organizationId, id])
  @@unique([organizationId, fiscalYearId, number])
  @@unique([organizationId, journalEntryId])
  @@unique([organizationId, voidEntryId])
  @@unique([organizationId, selfInvoiceNumber])
  @@index([organizationId, contactId])
  @@index([organizationId, status, dueDate])
  @@map("bills")
}

model BillLine {
  id             String    @id @default(uuid()) @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  billId         String    @map("bill_id") @db.Uuid
  lineNo         Int       @map("line_no")
  itemId         String?   @map("item_id") @db.Uuid
  description    String
  quantity       Decimal   @db.Decimal(13, 4)
  /// The quantity and price are in the item's second unit
  inAltUnit      Boolean   @default(false) @map("in_alt_unit")
  /// The serial numbers of the units bought
  serials        String[]  @default([])
  /// For goods kept in batches: the batch that came in, with its dates
  batchNo        String?   @map("batch_no")
  mfgDate        DateTime? @map("mfg_date") @db.Date
  expiryDate     DateTime? @map("expiry_date") @db.Date
  unitPrice      BigInt    @map("unit_price")
  discountPpm    Int       @default(0) @map("discount_ppm")
  taxGroupId     String?   @map("tax_group_id") @db.Uuid
  /// Under reverse charge: the GST we pay on the line (the vendor charges none)
  rcmTaxGroupId  String?   @map("rcm_tax_group_id") @db.Uuid
  /// Input tax credit: eligible | blocked (s.17(5)) | ineligible (e.g. personal or exempt use); not eligible = GST is cost
  itc            String    @default("eligible")
  accountId      String?   @map("account_id") @db.Uuid
  amount         BigInt
  taxAmount      BigInt    @default(0) @map("tax_amount")
  costCentreId   String?   @map("cost_centre_id") @db.Uuid

  organization Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  costCentre   CostCentre?        @relation(fields: [organizationId, costCentreId], references: [organizationId, id], onDelete: NoAction)
  bill         Bill               @relation(fields: [organizationId, billId], references: [organizationId, id], onDelete: Cascade)
  item         Item?              @relation(fields: [organizationId, itemId], references: [organizationId, id], onDelete: NoAction)
  taxGroup     TaxGroup?          @relation(fields: [organizationId, taxGroupId], references: [organizationId, id], onDelete: NoAction)
  rcmTaxGroup  TaxGroup?          @relation("BillLineRcmGroup", fields: [organizationId, rcmTaxGroupId], references: [organizationId, id], onDelete: NoAction)
  account      Account?           @relation("BillLineAccount", fields: [organizationId, accountId], references: [organizationId, id], onDelete: NoAction)
  /// What's been returned or credited of it on debit notes
  credited     VendorCreditLine[]

  @@unique([organizationId, id])
  @@unique([billId, lineNo])
  @@map("bill_lines")
}

/// A debit note to a vendor (a purchase return, or a credit the supplier gives): some of a bill's lines back, its input
/// tax reversed. It comes off the bill; what's left is credit with the vendor, for their other bills or a refund.
model VendorCredit {
  id               String    @id @default(uuid()) @db.Uuid
  organizationId   String    @map("organization_id") @db.Uuid
  /// Gap-free per financial year
  number           Int
  /// The series that numbered it, and the number as written (kept, so changing the series never renumbers it)
  seriesId         String?   @map("series_id") @db.Uuid
  fullNumber       String?   @map("full_number")
  fiscalYearId     String    @map("fiscal_year_id") @db.Uuid
  contactId        String    @map("contact_id") @db.Uuid
  billId           String    @map("bill_id") @db.Uuid
  date             DateTime  @db.Date
  status           String    @default("issued") /// issued | void
  /// The supplier's own credit note number, when they issued one
  vendorReference  String?   @map("vendor_reference")
  reason           String?
  payableAccountId String    @map("payable_account_id") @db.Uuid
  subtotal         BigInt
  taxTotal         BigInt    @map("tax_total")
  total            BigInt
  /// Applied to bills or refunded
  applied          BigInt    @default(0)
  journalEntryId   String    @map("journal_entry_id") @db.Uuid
  voidEntryId      String?   @map("void_entry_id") @db.Uuid
  createdById      String?   @map("created_by_id") @db.Uuid
  createdAt        DateTime  @default(now()) @map("created_at")
  voidedAt         DateTime? @map("voided_at")

  organization   Organization              @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  fiscalYear     FiscalYear                @relation(fields: [organizationId, fiscalYearId], references: [organizationId, id], onDelete: NoAction)
  series         NumberSeries?             @relation(fields: [organizationId, seriesId], references: [organizationId, id], onDelete: NoAction)
  contact        Contact                   @relation(fields: [organizationId, contactId], references: [organizationId, id], onDelete: NoAction)
  bill           Bill                      @relation(fields: [organizationId, billId], references: [organizationId, id], onDelete: NoAction)
  payableAccount Account                   @relation("VendorCreditPayable", fields: [organizationId, payableAccountId], references: [organizationId, id], onDelete: NoAction)
  journalEntry   JournalEntry              @relation("VendorCreditEntry", fields: [organizationId, journalEntryId], references: [organizationId, id], onDelete: NoAction)
  voidEntry      JournalEntry?             @relation("VendorCreditVoidEntry", fields: [organizationId, voidEntryId], references: [organizationId, id], onDelete: NoAction)
  lines          VendorCreditLine[]
  applications   VendorCreditApplication[]

  @@unique([organizationId, id])
  @@unique([organizationId, fiscalYearId, fullNumber])
  @@unique([seriesId, fiscalYearId, number])
  @@unique([organizationId, journalEntryId])
  @@unique([organizationId, voidEntryId])
  @@index([organizationId, contactId])
  @@index([organizationId, billId])
  @@map("vendor_credits")
}

/// A line of a debit note: a quantity of one of the bill's lines, at its price, discount and tax.
model VendorCreditLine {
  id             String  @id @default(uuid()) @db.Uuid
  organizationId String  @map("organization_id") @db.Uuid
  vendorCreditId String  @map("vendor_credit_id") @db.Uuid
  lineNo         Int     @map("line_no")
  billLineId     String  @map("bill_line_id") @db.Uuid
  description    String
  quantity       Decimal @db.Decimal(13, 4)
  unitPrice      BigInt  @map("unit_price")
  discountPpm    Int     @default(0) @map("discount_ppm")
  taxGroupId     String? @map("tax_group_id") @db.Uuid
  accountId      String  @map("account_id") @db.Uuid
  amount         BigInt
  taxAmount      BigInt  @default(0) @map("tax_amount")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  vendorCredit VendorCredit @relation(fields: [organizationId, vendorCreditId], references: [organizationId, id], onDelete: Cascade)
  billLine     BillLine     @relation(fields: [organizationId, billLineId], references: [organizationId, id], onDelete: NoAction)
  taxGroup     TaxGroup?    @relation(fields: [organizationId, taxGroupId], references: [organizationId, id], onDelete: NoAction)
  account      Account      @relation("VendorCreditLineAccount", fields: [organizationId, accountId], references: [organizationId, id], onDelete: NoAction)

  @@unique([vendorCreditId, lineNo])
  @@index([organizationId, billLineId])
  @@map("vendor_credit_lines")
}

/// Where a debit note's credit went: onto a bill of the vendor, or back from the vendor into a bank (a refund, with its entry).
model VendorCreditApplication {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  vendorCreditId String   @map("vendor_credit_id") @db.Uuid
  /// Exactly one of a bill or a refund entry
  billId         String?  @map("bill_id") @db.Uuid
  journalEntryId String?  @map("journal_entry_id") @db.Uuid
  bankAccountId  String?  @map("bank_account_id") @db.Uuid
  date           DateTime @db.Date
  amount         BigInt
  reference      String?
  createdById    String?  @map("created_by_id") @db.Uuid
  createdAt      DateTime @default(now()) @map("created_at")

  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  vendorCredit VendorCredit  @relation(fields: [organizationId, vendorCreditId], references: [organizationId, id], onDelete: Cascade)
  bill         Bill?         @relation(fields: [organizationId, billId], references: [organizationId, id], onDelete: NoAction)
  journalEntry JournalEntry? @relation("VendorRefundEntry", fields: [organizationId, journalEntryId], references: [organizationId, id], onDelete: NoAction)
  bankAccount  Account?      @relation("VendorRefundBank", fields: [organizationId, bankAccountId], references: [organizationId, id], onDelete: NoAction)

  @@unique([organizationId, journalEntryId])
  @@index([organizationId, vendorCreditId])
  @@index([organizationId, billId])
  @@map("vendor_credit_applications")
}

/// A correction to an issued invoice: some or all of its lines taken back, tax included. What it credits comes off
/// the invoice first; the rest is the customer's credit, to apply to another invoice or refund.
model CreditNote {
  id                  String    @id @default(uuid()) @db.Uuid
  organizationId      String    @map("organization_id") @db.Uuid
  /// Gap-free per financial year
  number              Int
  /// The series that numbered it, and the number as written (kept, so changing the series never renumbers it)
  seriesId            String?   @map("series_id") @db.Uuid
  fullNumber          String?   @map("full_number")
  fiscalYearId        String    @map("fiscal_year_id") @db.Uuid
  contactId           String    @map("contact_id") @db.Uuid
  invoiceId           String    @map("invoice_id") @db.Uuid
  date                DateTime  @db.Date
  status              String    @default("issued") /// issued | void
  /// The invoice's currency and the rate it was posted at
  currency            String?   @db.Char(3)
  rate                Decimal?  @db.Decimal(20, 10)
  reason              String?
  receivableAccountId String    @map("receivable_account_id") @db.Uuid
  subtotal            BigInt
  taxTotal            BigInt    @map("tax_total")
  total               BigInt
  /// Applied to invoices or refunded
  applied             BigInt    @default(0)
  journalEntryId      String    @map("journal_entry_id") @db.Uuid
  voidEntryId         String?   @map("void_entry_id") @db.Uuid
  createdById         String?   @map("created_by_id") @db.Uuid
  createdAt           DateTime  @default(now()) @map("created_at")
  voidedAt            DateTime? @map("voided_at")

  organization      Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  fiscalYear        FiscalYear          @relation(fields: [organizationId, fiscalYearId], references: [organizationId, id], onDelete: NoAction)
  series            NumberSeries?       @relation(fields: [organizationId, seriesId], references: [organizationId, id], onDelete: NoAction)
  contact           Contact             @relation(fields: [organizationId, contactId], references: [organizationId, id], onDelete: NoAction)
  invoice           Invoice             @relation(fields: [organizationId, invoiceId], references: [organizationId, id], onDelete: NoAction)
  receivableAccount Account             @relation("CreditNoteReceivable", fields: [organizationId, receivableAccountId], references: [organizationId, id], onDelete: NoAction)
  journalEntry      JournalEntry        @relation("CreditNoteEntry", fields: [organizationId, journalEntryId], references: [organizationId, id], onDelete: NoAction)
  voidEntry         JournalEntry?       @relation("CreditNoteVoidEntry", fields: [organizationId, voidEntryId], references: [organizationId, id], onDelete: NoAction)
  lines             CreditNoteLine[]
  applications      CreditApplication[]

  @@unique([organizationId, id])
  @@unique([organizationId, fiscalYearId, fullNumber])
  @@unique([seriesId, fiscalYearId, number])
  @@unique([organizationId, journalEntryId])
  @@unique([organizationId, voidEntryId])
  @@index([organizationId, contactId])
  @@index([organizationId, invoiceId])
  @@map("credit_notes")
}

/// A line of a credit note: a quantity of one of the invoice's lines, at its price, discount and tax.
model CreditNoteLine {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  creditNoteId   String   @map("credit_note_id") @db.Uuid
  lineNo         Int      @map("line_no")
  invoiceLineId  String   @map("invoice_line_id") @db.Uuid
  description    String
  quantity       Decimal  @db.Decimal(13, 4)
  /// The serial numbers of the units that came back
  serials        String[] @default([])
  unitPrice      BigInt   @map("unit_price")
  discountPpm    Int      @default(0) @map("discount_ppm")
  taxGroupId     String?  @map("tax_group_id") @db.Uuid
  accountId      String   @map("account_id") @db.Uuid
  amount         BigInt
  taxAmount      BigInt   @default(0) @map("tax_amount")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  creditNote   CreditNote   @relation(fields: [organizationId, creditNoteId], references: [organizationId, id], onDelete: Cascade)
  invoiceLine  InvoiceLine  @relation(fields: [organizationId, invoiceLineId], references: [organizationId, id], onDelete: NoAction)
  taxGroup     TaxGroup?    @relation(fields: [organizationId, taxGroupId], references: [organizationId, id], onDelete: NoAction)
  account      Account      @relation("CreditNoteLineAccount", fields: [organizationId, accountId], references: [organizationId, id], onDelete: NoAction)

  @@unique([creditNoteId, lineNo])
  @@index([organizationId, invoiceLineId])
  @@map("credit_note_lines")
}

/// Where a credit note's credit went: onto an invoice, or back to the customer from a bank (a refund, with its entry).
model CreditApplication {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  creditNoteId   String   @map("credit_note_id") @db.Uuid
  /// Exactly one of an invoice or a refund entry
  invoiceId      String?  @map("invoice_id") @db.Uuid
  journalEntryId String?  @map("journal_entry_id") @db.Uuid
  bankAccountId  String?  @map("bank_account_id") @db.Uuid
  date           DateTime @db.Date
  amount         BigInt
  /// For a foreign refund: the rate it was paid at
  rate           Decimal? @db.Decimal(20, 10)
  reference      String?
  createdById    String?  @map("created_by_id") @db.Uuid
  createdAt      DateTime @default(now()) @map("created_at")

  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  creditNote   CreditNote    @relation(fields: [organizationId, creditNoteId], references: [organizationId, id], onDelete: Cascade)
  invoice      Invoice?      @relation(fields: [organizationId, invoiceId], references: [organizationId, id], onDelete: NoAction)
  journalEntry JournalEntry? @relation("CreditRefundEntry", fields: [organizationId, journalEntryId], references: [organizationId, id], onDelete: NoAction)
  bankAccount  Account?      @relation("CreditRefundBank", fields: [organizationId, bankAccountId], references: [organizationId, id], onDelete: NoAction)

  @@unique([organizationId, journalEntryId])
  @@index([organizationId, creditNoteId])
  @@index([organizationId, invoiceId])
  @@map("credit_applications")
}

/// Raises an invoice from its template on a schedule: weekly, monthly, quarterly or yearly, until an end date or count.
model RecurringInvoice {
  id             String    @id @default(uuid()) @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  name           String
  contactId      String    @map("contact_id") @db.Uuid
  frequency      String /// weekly | monthly | quarterly | yearly
  interval       Int       @default(1)
  startDate      DateTime  @map("start_date") @db.Date
  endDate        DateTime? @map("end_date") @db.Date
  maxCount       Int?      @map("max_count")
  /// Invoices raised so far; the next is the count-th date from the start
  count          Int       @default(0)
  /// null once it has ended
  nextDate       DateTime? @map("next_date") @db.Date
  autoIssue      Boolean   @default(false) @map("auto_issue")
  status         String    @default("active") /// active | paused | ended
  /// What each invoice is made of: lines, reference, notes, place of supply
  template       Json
  lastRunAt      DateTime? @map("last_run_at")
  /// Why the last attempt failed, until one succeeds
  lastError      String?   @map("last_error")
  createdById    String?   @map("created_by_id") @db.Uuid
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  contact      Contact      @relation(fields: [organizationId, contactId], references: [organizationId, id], onDelete: NoAction)
  invoices     Invoice[]

  @@unique([organizationId, id])
  @@index([status, nextDate])
  @@map("recurring_invoices")
}

/// Money in or out of a bank or cash account that isn't an invoice or bill, or a transfer between two of them.
model BankTransaction {
  id             String    @id @default(uuid()) @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  kind           String /// spend | receive | transfer
  status         String    @default("posted") /// posted | void
  /// The account money leaves (spend, transfer) or arrives in (receive)
  bankAccountId  String    @map("bank_account_id") @db.Uuid
  /// A transfer's other account
  toAccountId    String?   @map("to_account_id") @db.Uuid
  date           DateTime  @db.Date
  contactId      String?   @map("contact_id") @db.Uuid
  reference      String?
  description    String?
  /// The bank account's currency (null = base); a transfer's receiving side may differ
  currency       String?   @db.Char(3)
  amount         BigInt
  toCurrency     String?   @map("to_currency") @db.Char(3)
  toAmount       BigInt?   @map("to_amount")
  rate           Decimal?  @db.Decimal(20, 10)
  taxInclusive   Boolean   @default(false) @map("tax_inclusive")
  /// What each line went to, as entered
  lines          Json?
  journalEntryId String    @map("journal_entry_id") @db.Uuid
  voidEntryId    String?   @map("void_entry_id") @db.Uuid
  createdById    String?   @map("created_by_id") @db.Uuid
  createdAt      DateTime  @default(now()) @map("created_at")
  voidedAt       DateTime? @map("voided_at")

  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  bankAccount  Account       @relation("BankTransactionAccount", fields: [organizationId, bankAccountId], references: [organizationId, id], onDelete: NoAction)
  toAccount    Account?      @relation("BankTransferTo", fields: [organizationId, toAccountId], references: [organizationId, id], onDelete: NoAction)
  contact      Contact?      @relation(fields: [organizationId, contactId], references: [organizationId, id], onDelete: NoAction)
  journalEntry JournalEntry  @relation("BankTransactionEntry", fields: [organizationId, journalEntryId], references: [organizationId, id], onDelete: NoAction)
  voidEntry    JournalEntry? @relation("BankTransactionVoidEntry", fields: [organizationId, voidEntryId], references: [organizationId, id], onDelete: NoAction)

  @@unique([organizationId, id])
  @@unique([organizationId, journalEntryId])
  @@unique([organizationId, voidEntryId])
  @@index([organizationId, bankAccountId, date])
  @@index([organizationId, toAccountId, date])
  @@map("bank_transactions")
}

/// One upload of a bank's statement for an account.
model BankStatementImport {
  id             String    @id @default(uuid()) @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  bankAccountId  String    @map("bank_account_id") @db.Uuid
  fileName       String    @map("file_name")
  format         String /// csv | ofx
  /// Lines added, and lines already there from an earlier import
  added          Int
  duplicates     Int
  /// Rows that couldn't be read (date, amount or description)
  rejected       Int
  firstDate      DateTime? @map("first_date") @db.Date
  lastDate       DateTime? @map("last_date") @db.Date
  createdById    String?   @map("created_by_id") @db.Uuid
  createdAt      DateTime  @default(now()) @map("created_at")

  organization Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  bankAccount  Account             @relation(fields: [organizationId, bankAccountId], references: [organizationId, id], onDelete: NoAction)
  lines        BankStatementLine[]

  @@unique([organizationId, id])
  @@index([organizationId, bankAccountId, createdAt])
  @@map("bank_statement_imports")
}

/// A line of the bank's own record: money in (positive) or out (negative) on a day, waiting to be reconciled.
model BankStatementLine {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  bankAccountId  String   @map("bank_account_id") @db.Uuid
  importId       String   @map("import_id") @db.Uuid
  date           DateTime @db.Date
  description    String
  reference      String?
  /// In the account's currency's smallest unit: in positive, out negative
  amount         BigInt
  /// The running balance the bank printed, if any
  balance        BigInt?
  /// What makes the line itself, so the same statement never imports twice
  fingerprint    String
  status         String   @default("unmatched") /// unmatched | matched | ignored
  createdAt      DateTime @default(now()) @map("created_at")

  organization Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  bankAccount  Account             @relation(fields: [organizationId, bankAccountId], references: [organizationId, id], onDelete: NoAction)
  import       BankStatementImport @relation(fields: [organizationId, importId], references: [organizationId, id], onDelete: Cascade)

  matches BankMatch[]

  @@unique([organizationId, id])
  @@unique([organizationId, bankAccountId, fingerprint])
  @@index([organizationId, bankAccountId, status, date])
  @@map("bank_statement_lines")
}

/// How an account's CSV statements are laid out, remembered from the last import.
model BankStatementLayout {
  organizationId String   @map("organization_id") @db.Uuid
  bankAccountId  String   @map("bank_account_id") @db.Uuid
  mapping        Json
  updatedAt      DateTime @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  bankAccount  Account      @relation(fields: [organizationId, bankAccountId], references: [organizationId, id], onDelete: Cascade)

  @@id([organizationId, bankAccountId])
  @@map("bank_statement_layouts")
}

/// A book line (on a bank or cash account) matched to a line of the bank's statement. A statement line can match
/// several book lines (a deposit of two receipts); a book line matches once.
model BankMatch {
  id               String   @id @default(uuid()) @db.Uuid
  organizationId   String   @map("organization_id") @db.Uuid
  statementLineId  String   @map("statement_line_id") @db.Uuid
  journalLineId    String   @map("journal_line_id") @db.Uuid
  /// Set once reconciled: then it can't be undone without undoing the reconciliation
  reconciliationId String?  @map("reconciliation_id") @db.Uuid
  createdById      String?  @map("created_by_id") @db.Uuid
  createdAt        DateTime @default(now()) @map("created_at")

  organization   Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  statementLine  BankStatementLine   @relation(fields: [organizationId, statementLineId], references: [organizationId, id], onDelete: Cascade)
  journalLine    JournalLine         @relation(fields: [organizationId, journalLineId], references: [organizationId, id], onDelete: Cascade)
  reconciliation BankReconciliation? @relation(fields: [organizationId, reconciliationId], references: [organizationId, id], onDelete: NoAction)

  @@unique([organizationId, journalLineId])
  @@index([organizationId, statementLineId])
  @@index([organizationId, reconciliationId])
  @@map("bank_matches")
}

/// An account agreed with the bank's statement on a day: its balance then, and the matches it locked.
model BankReconciliation {
  id               String   @id @default(uuid()) @db.Uuid
  organizationId   String   @map("organization_id") @db.Uuid
  bankAccountId    String   @map("bank_account_id") @db.Uuid
  statementDate    DateTime @map("statement_date") @db.Date
  /// In the account's currency
  statementBalance BigInt   @map("statement_balance")
  bookBalance      BigInt   @map("book_balance")
  /// Book items not yet through the bank on the day: in (deposits in transit) and out (unpresented payments)
  outstandingIn    BigInt   @map("outstanding_in")
  outstandingOut   BigInt   @map("outstanding_out")
  createdById      String?  @map("created_by_id") @db.Uuid
  createdAt        DateTime @default(now()) @map("created_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  bankAccount  Account      @relation(fields: [organizationId, bankAccountId], references: [organizationId, id], onDelete: NoAction)
  matches      BankMatch[]

  @@unique([organizationId, id])
  @@index([organizationId, bankAccountId, statementDate])
  @@map("bank_reconciliations")
}

/// Something the business owns and uses for years, worn down month by month.
model FixedAsset {
  id                   String    @id @default(uuid()) @db.Uuid
  organizationId       String    @map("organization_id") @db.Uuid
  name                 String
  /// e.g. FA-0001, unique in the organisation
  tag                  String
  description          String?
  costAccountId        String    @map("cost_account_id") @db.Uuid
  accumulatedAccountId String    @map("accumulated_account_id") @db.Uuid
  expenseAccountId     String    @map("expense_account_id") @db.Uuid
  cost                 BigInt
  residual             BigInt    @default(0)
  inServiceDate        DateTime  @map("in_service_date") @db.Date
  method               String /// straight_line | wdv
  usefulLifeMonths     Int?      @map("useful_life_months")
  /// Written-down value: the yearly rate, in ppm
  wdvRatePpm           Int?      @map("wdv_rate_ppm")
  /// Depreciation already charged before the asset was added here
  openingAccumulated   BigInt    @default(0) @map("opening_accumulated")
  /// Depreciation so far: the opening amount plus every run since
  accumulated          BigInt    @default(0)
  /// The last day depreciation has been charged up to
  depreciatedTo        DateTime? @map("depreciated_to") @db.Date
  status               String    @default("active") /// active | disposed
  disposedOn           DateTime? @map("disposed_on") @db.Date
  proceeds             BigInt?
  disposalEntryId      String?   @map("disposal_entry_id") @db.Uuid
  createdById          String?   @map("created_by_id") @db.Uuid
  createdAt            DateTime  @default(now()) @map("created_at")
  updatedAt            DateTime  @updatedAt @map("updated_at")

  organization       Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  costAccount        Account            @relation("AssetCostAccount", fields: [organizationId, costAccountId], references: [organizationId, id], onDelete: NoAction)
  accumulatedAccount Account            @relation("AssetAccumulatedAccount", fields: [organizationId, accumulatedAccountId], references: [organizationId, id], onDelete: NoAction)
  expenseAccount     Account            @relation("AssetExpenseAccount", fields: [organizationId, expenseAccountId], references: [organizationId, id], onDelete: NoAction)
  disposalEntry      JournalEntry?      @relation("AssetDisposalEntry", fields: [organizationId, disposalEntryId], references: [organizationId, id], onDelete: NoAction)
  depreciation       DepreciationLine[]

  @@unique([organizationId, id])
  @@unique([organizationId, tag])
  @@unique([organizationId, disposalEntryId])
  @@map("fixed_assets")
}

/// One posting of depreciation up to a month's end: a single entry, a line per asset.
model DepreciationRun {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  upTo           DateTime @map("up_to") @db.Date
  total          BigInt
  journalEntryId String   @map("journal_entry_id") @db.Uuid
  createdById    String?  @map("created_by_id") @db.Uuid
  createdAt      DateTime @default(now()) @map("created_at")

  organization Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  journalEntry JournalEntry       @relation("DepreciationEntry", fields: [organizationId, journalEntryId], references: [organizationId, id], onDelete: NoAction)
  lines        DepreciationLine[]

  @@unique([organizationId, id])
  @@unique([organizationId, journalEntryId])
  @@index([organizationId, upTo])
  @@map("depreciation_runs")
}

/// An asset's share of a run: the days charged, and where it stood before (so the run can be undone)
model DepreciationLine {
  id             String    @id @default(uuid()) @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  runId          String    @map("run_id") @db.Uuid
  assetId        String    @map("asset_id") @db.Uuid
  fromDate       DateTime  @map("from_date") @db.Date
  toDate         DateTime  @map("to_date") @db.Date
  amount         BigInt
  previousTo     DateTime? @map("previous_to") @db.Date

  organization Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  run          DepreciationRun @relation(fields: [organizationId, runId], references: [organizationId, id], onDelete: Cascade)
  asset        FixedAsset      @relation(fields: [organizationId, assetId], references: [organizationId, id], onDelete: Cascade)

  @@index([organizationId, assetId])
  @@map("depreciation_lines")
}

/// A plan for a financial year: what each income and expense account should come to, month by month.
model Budget {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  fiscalYearId   String   @map("fiscal_year_id") @db.Uuid
  name           String
  /// A plan for one cost centre or project; none = the whole organisation
  costCentreId   String?  @map("cost_centre_id") @db.Uuid
  createdById    String?  @map("created_by_id") @db.Uuid
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  fiscalYear   FiscalYear   @relation(fields: [organizationId, fiscalYearId], references: [organizationId, id], onDelete: Cascade)
  costCentre   CostCentre?  @relation(fields: [organizationId, costCentreId], references: [organizationId, id], onDelete: NoAction)
  lines        BudgetLine[]

  @@unique([organizationId, id])
  @@unique([organizationId, fiscalYearId, name])
  @@map("budgets")
}

/// One account's budget for one month; income and expenses both positive
model BudgetLine {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  budgetId       String   @map("budget_id") @db.Uuid
  accountId      String   @map("account_id") @db.Uuid
  /// The first day of the month
  month          DateTime @db.Date
  amount         BigInt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  budget       Budget       @relation(fields: [organizationId, budgetId], references: [organizationId, id], onDelete: Cascade)
  account      Account      @relation(fields: [organizationId, accountId], references: [organizationId, id], onDelete: Cascade)

  @@unique([budgetId, accountId, month])
  @@index([organizationId, budgetId])
  @@map("budget_lines")
}

/// A part of the business (a department or branch) or a project that lines are tagged with, to see profit by each.
model CostCentre {
  id             String    @id @default(uuid()) @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  code           String
  name           String
  /// department | project
  kind           String    @default("department")
  description    String?
  archivedAt     DateTime? @map("archived_at") @db.Timestamptz(3)
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  journalLines JournalLine[]
  invoiceLines InvoiceLine[]
  quoteLines   QuoteLine[]
  billLines    BillLine[]
  budgets      Budget[]

  @@unique([organizationId, id])
  @@unique([organizationId, code])
  @@map("cost_centres")
}

/// Stock in or out of a tracked item: from a bill, an invoice, an adjustment, or undoing one of them. The quantity
/// on hand is the sum of the quantities, and its value the sum of the values (both negative going out).
model StockMovement {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  itemId         String   @map("item_id") @db.Uuid
  date           DateTime @db.Date
  /// bill | bill_void | invoice | invoice_void | adjustment | adjustment_undo
  kind           String
  /// The bill or invoice it came from; for an undo, the movement it undoes
  sourceId       String?  @map("source_id") @db.Uuid
  quantity       Decimal  @db.Decimal(13, 4)
  /// In the base currency's smallest unit
  value          BigInt
  reason         String?
  journalEntryId String?  @map("journal_entry_id") @db.Uuid
  createdById    String?  @map("created_by_id") @db.Uuid
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  /// The batch it moved, for goods kept in batches
  batchId        String?  @map("batch_id") @db.Uuid
  /// The invoice, bill or credit note line it came from
  sourceLineId   String?  @map("source_line_id") @db.Uuid
  /// The serial numbers of the units it moved (goods with serial numbers)
  serials        String[] @default([])

  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  item         Item          @relation(fields: [organizationId, itemId], references: [organizationId, id], onDelete: NoAction)
  journalEntry JournalEntry? @relation(fields: [organizationId, journalEntryId], references: [organizationId, id], onDelete: NoAction)
  batch        StockBatch?   @relation(fields: [organizationId, batchId], references: [organizationId, id], onDelete: NoAction)

  @@unique([organizationId, id])
  @@index([organizationId, itemId, date])
  @@index([organizationId, sourceId])
  @@index([organizationId, batchId])
  @@index([serials], type: Gin)
  @@map("stock_movements")
}

/// Journal entries, bills or vendor payments at or above an amount need an approver's yes before they post.
model ApprovalRule {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  /// journal | bill | payment
  documentType   String   @map("document_type")
  /// In the base currency's smallest unit
  minAmount      BigInt   @map("min_amount")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, documentType])
  @@map("approval_rules")
}

/// A document held for approval: approving posts it; sending it back leaves it as it was, with a note.
model ApprovalRequest {
  id             String    @id @default(uuid()) @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  /// journal | bill | payment
  documentType   String    @map("document_type")
  /// The journal entry or bill held; for a payment, the payment once approved
  documentId     String?   @map("document_id") @db.Uuid
  /// What a held payment will be, as it was entered
  payload        Json?
  /// In the base currency's smallest unit
  amount         BigInt
  summary        String
  /// pending | approved | rejected | cancelled
  status         String    @default("pending")
  requestedById  String    @map("requested_by_id") @db.Uuid
  decidedById    String?   @map("decided_by_id") @db.Uuid
  decidedAt      DateTime? @map("decided_at") @db.Timestamptz(3)
  note           String?
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  requestedBy  User         @relation("ApprovalRequester", fields: [requestedById], references: [id], onDelete: NoAction)
  decidedBy    User?        @relation("ApprovalDecider", fields: [decidedById], references: [id], onDelete: NoAction)

  @@index([organizationId, status, createdAt])
  @@index([organizationId, documentId])
  @@map("approval_requests")
}

/// A receipt, PDF or photo kept with an invoice, bill, payment or bank transaction (journal entries have their own).
model DocumentAttachment {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  /// invoice | bill | payment | bank_transaction
  documentType   String   @map("document_type")
  documentId     String   @map("document_id") @db.Uuid
  fileName       String   @map("file_name")
  contentType    String   @map("content_type")
  size           Int
  data           Bytes
  uploadedById   String?  @map("uploaded_by_id") @db.Uuid
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, documentType, documentId])
  @@map("document_attachments")
}

/// A key another system uses to call the API: it acts for the person who made it, within its scopes.
/// Only a hash is kept; the key itself is shown once.
model ApiKey {
  id             String    @id @default(uuid()) @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  name           String
  /// The first characters, to tell keys apart (e.g. lnk_3f9a1c)
  prefix         String
  /// SHA-256 of the whole key
  hash           String    @unique
  scopes         String[]
  createdById    String    @map("created_by_id") @db.Uuid
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  lastUsedAt     DateTime? @map("last_used_at") @db.Timestamptz(3)
  expiresAt      DateTime? @map("expires_at") @db.Timestamptz(3)
  revokedAt      DateTime? @map("revoked_at") @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdBy    User         @relation(fields: [createdById], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@map("api_keys")
}

/// Where to tell another system that invoices, payments or bills changed. Each request is signed with the secret.
model WebhookEndpoint {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  url            String
  description    String?
  events         String[]
  /// Signs each delivery (HMAC-SHA256); shown when made or rotated
  secret         String
  active         Boolean  @default(true)
  createdById    String?  @map("created_by_id") @db.Uuid
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  organization Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  deliveries   WebhookDelivery[]
  /// Who last changed it
  updatedBy    User?             @relation(fields: [updatedById], references: [id])
  updatedById  String?           @map("userId") @db.Uuid

  @@unique([organizationId, id])
  @@index([organizationId])
  @@map("webhook_endpoints")
}

/// One event sent to one endpoint, with its attempts: retried with backoff until it succeeds or is given up.
model WebhookDelivery {
  id             String    @id @default(uuid()) @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  endpointId     String    @map("endpoint_id") @db.Uuid
  event          String
  payload        Json
  /// pending | succeeded | failed
  status         String    @default("pending")
  attempts       Int       @default(0)
  nextAttemptAt  DateTime? @default(now()) @map("next_attempt_at") @db.Timestamptz(3)
  lastStatus     Int?      @map("last_status")
  lastError      String?   @map("last_error")
  deliveredAt    DateTime? @map("delivered_at") @db.Timestamptz(3)
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  organization  Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  endpoint      WebhookEndpoint @relation(fields: [organizationId, endpointId], references: [organizationId, id], onDelete: Cascade)
  /// Whose action sent it (an invoice issued, a test ping); none for retries
  triggeredBy   User?           @relation(fields: [triggeredById], references: [id])
  triggeredById String?         @map("userId") @db.Uuid

  @@index([status, nextAttemptAt])
  @@index([organizationId, endpointId, createdAt])
  @@map("webhook_deliveries")
}

/// A report that arrives by itself: built weekly or monthly, kept, and emailed to members chosen.
model ScheduledReport {
  id             String    @id @default(uuid()) @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  name           String
  /// profit_and_loss | balance_sheet | trial_balance | receivables_aging | payables_aging
  report         String
  /// weekly | monthly
  frequency      String
  /// weekly: 1 (Monday) to 7; monthly: the day, 1 to 28
  day            Int
  /// xlsx | csv
  format         String
  /// Members it goes to (user ids)
  recipients     String[]
  active         Boolean   @default(true)
  nextRunAt      DateTime  @map("next_run_at") @db.Timestamptz(3)
  lastRunAt      DateTime? @map("last_run_at") @db.Timestamptz(3)
  createdById    String    @map("created_by_id") @db.Uuid
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  organization Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  deliveries   ReportDelivery[]

  @@unique([organizationId, id])
  @@index([active, nextRunAt])
  @@map("scheduled_reports")
}

/// One run of a scheduled report: the file made, the period it covers, and who it was emailed to.
model ReportDelivery {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  scheduleId     String   @map("schedule_id") @db.Uuid
  periodFrom     DateTime @map("period_from") @db.Date
  periodTo       DateTime @map("period_to") @db.Date
  fileName       String   @map("file_name")
  contentType    String   @map("content_type")
  data           Bytes
  /// The addresses it was emailed to (none when email isn't set up)
  emailedTo      String[] @map("emailed_to")
  error          String?
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  organization Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  schedule     ScheduledReport @relation(fields: [organizationId, scheduleId], references: [organizationId, id], onDelete: Cascade)

  @@index([organizationId, scheduleId, createdAt])
  @@map("report_deliveries")
}

/// When overdue invoices get automatic payment reminders: the first some days after the due date, then every so
/// many days, up to a limit. Manual reminders count towards the limit and the spacing.
model ReminderPolicy {
  id              String   @id @default(uuid()) @db.Uuid
  organizationId  String   @unique @map("organization_id") @db.Uuid
  enabled         Boolean  @default(false)
  firstAfterDays  Int      @default(3) @map("first_after_days")
  repeatEveryDays Int      @default(7) @map("repeat_every_days")
  maxReminders    Int      @default(3) @map("max_reminders")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@map("reminder_policies")
}

/// A quote (estimate) for a customer: priced like an invoice but posts nothing. It can be sent, accepted or
/// declined, and turned into a draft invoice with the same lines.
model Quote {
  id             String    @id @default(uuid()) @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  number         Int
  contactId      String    @map("contact_id") @db.Uuid
  status         String    @default("draft") /// draft | sent | accepted | declined | invoiced
  quoteDate      DateTime  @map("quote_date") @db.Date
  expiryDate     DateTime  @map("expiry_date") @db.Date
  currency       String?   @db.Char(3)
  placeOfSupply  String?   @map("place_of_supply") @db.Char(2)
  reference      String?
  notes          String?
  subtotal       BigInt    @default(0)
  taxTotal       BigInt    @default(0) @map("tax_total")
  total          BigInt    @default(0)
  /// The invoice it became
  invoiceId      String?   @map("invoice_id") @db.Uuid
  createdById    String?   @map("created_by_id") @db.Uuid
  sentAt         DateTime? @map("sent_at")
  decidedAt      DateTime? @map("decided_at")
  /// A link the customer opens without signing in, to accept or decline (random, revocable)
  shareToken     String?   @unique @map("share_token")
  shareViews     Int       @default(0) @map("share_views")
  shareViewedAt  DateTime? @map("share_viewed_at")
  /// Who accepted or declined it from the link, and what they said
  decidedBy      String?   @map("decided_by")
  decisionNote   String?   @map("decision_note")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  contact      Contact      @relation(fields: [organizationId, contactId], references: [organizationId, id], onDelete: NoAction)
  invoice      Invoice?     @relation(fields: [organizationId, invoiceId], references: [organizationId, id], onDelete: NoAction)
  lines        QuoteLine[]

  @@unique([organizationId, id])
  @@unique([organizationId, number])
  @@index([organizationId, status])
  @@map("quotes")
}

model QuoteLine {
  id             String  @id @default(uuid()) @db.Uuid
  organizationId String  @map("organization_id") @db.Uuid
  quoteId        String  @map("quote_id") @db.Uuid
  lineNo         Int     @map("line_no")
  itemId         String? @map("item_id") @db.Uuid
  description    String
  quantity       Decimal @db.Decimal(13, 4)
  unitPrice      BigInt  @map("unit_price")
  discountPpm    Int     @default(0) @map("discount_ppm")
  taxGroupId     String? @map("tax_group_id") @db.Uuid
  accountId      String? @map("account_id") @db.Uuid
  costCentreId   String? @map("cost_centre_id") @db.Uuid
  amount         BigInt
  taxAmount      BigInt  @default(0) @map("tax_amount")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  quote        Quote        @relation(fields: [organizationId, quoteId], references: [organizationId, id], onDelete: Cascade)
  item         Item?        @relation(fields: [organizationId, itemId], references: [organizationId, id], onDelete: NoAction)
  taxGroup     TaxGroup?    @relation(fields: [organizationId, taxGroupId], references: [organizationId, id], onDelete: NoAction)
  account      Account?     @relation("QuoteLineAccount", fields: [organizationId, accountId], references: [organizationId, id], onDelete: NoAction)
  costCentre   CostCentre?  @relation(fields: [organizationId, costCentreId], references: [organizationId, id], onDelete: NoAction)

  @@unique([organizationId, id])
  @@unique([quoteId, lineNo])
  @@map("quote_lines")
}

/// A schedule that makes bills from a vendor from a template (rent, subscriptions), like recurring invoices.
model RecurringBill {
  id             String    @id @default(uuid()) @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  name           String
  contactId      String    @map("contact_id") @db.Uuid
  frequency      String /// weekly | monthly | quarterly | yearly
  interval       Int       @default(1)
  startDate      DateTime  @map("start_date") @db.Date
  endDate        DateTime? @map("end_date") @db.Date
  maxCount       Int?      @map("max_count")
  /// Bills made so far; the next is the count-th date from the start
  count          Int       @default(0)
  /// null once it has ended
  nextDate       DateTime? @map("next_date") @db.Date
  autoRecord     Boolean   @default(false) @map("auto_record")
  status         String    @default("active") /// active | paused | ended
  /// What each bill is made of: lines, notes, place of supply
  template       Json
  lastRunAt      DateTime? @map("last_run_at")
  /// Why the last attempt failed, until one succeeds
  lastError      String?   @map("last_error")
  createdById    String?   @map("created_by_id") @db.Uuid
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  contact      Contact      @relation(fields: [organizationId, contactId], references: [organizationId, id], onDelete: NoAction)
  bills        Bill[]

  @@unique([organizationId, id])
  @@index([status, nextDate])
  @@map("recurring_bills")
}

/// A request to a customer or vendor to confirm their balance with us on a date (for the audit), answered from a link
model BalanceConfirmation {
  id             String    @id @default(uuid()) @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  contactId      String    @map("contact_id") @db.Uuid
  /// receivable (they owe us) | payable (we owe them)
  side           String
  asOf           DateTime  @map("as_of") @db.Date
  currency       String    @db.Char(3)
  /// As our books have it on the day, in the currency's smallest unit (negative: the other way round)
  balance        BigInt
  /// Random, for the link the party opens without signing in
  token          String    @unique
  /// pending | agreed | disputed
  status         String    @default("pending")
  /// The balance as their books have it, when they disagree
  theirBalance   BigInt?   @map("their_balance")
  note           String?
  respondedBy    String?   @map("responded_by")
  respondedAt    DateTime? @map("responded_at")
  sentTo         String?   @map("sent_to")
  views          Int       @default(0)
  createdById    String?   @map("created_by_id") @db.Uuid
  createdAt      DateTime  @default(now()) @map("created_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  contact      Contact      @relation(fields: [organizationId, contactId], references: [organizationId, id], onDelete: Cascade)

  @@unique([organizationId, contactId, side, asOf])
  @@index([organizationId, asOf])
  @@map("balance_confirmations")
}

/// India Post's answer for a PIN code, kept so the address form doesn't ask again (not per organisation: it's public data)
/// Bank branches by IFSC, from Razorpay's free directory, kept a month
model IfscCache {
  ifsc      String   @id @db.Char(11)
  /// The parsed lookup (null when the directory doesn't know it)
  data      Json?
  fetchedAt DateTime @default(now()) @map("fetched_at") @db.Timestamptz(6)

  @@map("ifsc_cache")
}

model PincodeCache {
  pin       String   @id @db.Char(6)
  /// The parsed lookup (null when India Post doesn't know the PIN)
  data      Json?
  fetchedAt DateTime @default(now()) @map("fetched_at") @db.Timestamptz(6)

  @@map("pincode_cache")
}

/// How documents of one type are numbered: a prefix and suffix around a serial (see shared numbering/)
model NumberSeries {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  /// invoice | credit_note | debit_note
  type           String
  name           String
  prefix         String   @default("")
  suffix         String   @default("")
  digits         Int      @default(4)
  startNumber    Int      @default(1) @map("start_number")
  /// Start again from the first number each financial year
  resetYearly    Boolean  @default(true) @map("reset_yearly")
  isDefault      Boolean  @default(false) @map("is_default")
  archived       Boolean  @default(false)
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization  Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  invoices      Invoice[]
  creditNotes   CreditNote[]
  vendorCredits VendorCredit[]

  @@unique([organizationId, id])
  @@unique([organizationId, type, name])
  @@map("number_series")
}

/// A batch (lot) of an item: the number on the pack, and when it was made and expires
model StockBatch {
  id             String    @id @default(uuid()) @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  itemId         String    @map("item_id") @db.Uuid
  batchNo        String    @map("batch_no")
  mfgDate        DateTime? @map("mfg_date") @db.Date
  expiryDate     DateTime? @map("expiry_date") @db.Date
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  organization Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  item         Item            @relation(fields: [organizationId, itemId], references: [organizationId, id], onDelete: Cascade)
  movements    StockMovement[]

  @@unique([organizationId, id])
  @@unique([organizationId, itemId, batchNo])
  @@index([organizationId, expiryDate])
  @@map("stock_batches")
}

/// One unit of goods with a serial number (an IMEI, a machine number) and where it is now
model StockSerial {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  itemId         String   @map("item_id") @db.Uuid
  /// Upper-cased as entered
  serialNo       String   @map("serial_no")
  /// in_stock | sold | written_off | removed (its bill was voided)
  status         String   @default("in_stock")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  item         Item         @relation(fields: [organizationId, itemId], references: [organizationId, id], onDelete: Cascade)

  @@unique([organizationId, id])
  @@unique([organizationId, itemId, serialNo])
  @@index([organizationId, serialNo])
  @@map("stock_serials")
}

/// Interest on late payment a customer is let off, on one invoice, and why
model InterestWaiver {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  invoiceId      String   @map("invoice_id") @db.Uuid
  amount         BigInt
  reason         String
  /// The day it was waived to
  date           DateTime @db.Date
  createdById    String?  @map("created_by_id") @db.Uuid
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  invoice      Invoice      @relation(fields: [organizationId, invoiceId], references: [organizationId, id], onDelete: Cascade)

  @@unique([organizationId, id])
  @@index([organizationId, invoiceId])
  @@map("interest_waivers")
}
